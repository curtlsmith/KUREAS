      "view3d": {
        "script": "# Reactor Protection System (RPS): 3D layout of its SSCs in the HSMR-77 buildings.\n# Parts are named with the SSC controlled names, so each part (or GROUP) links to its SSC.\n# Rooms and buildings come from the Project 3D script; cables are WIREs routed through the rooms.\n\nPART RPS_PLC_PRES_A_TRIP = BOX(W=0.8, H=2.0, L=0.6) IN CB_ICA AT (1.6, 0, 2.6) COLOR 0x7b4fb5;\nPART RPS_SWC_MAN_A_TRIP = BOX(W=0.3, H=0.25, L=0.2) IN CB_MCR AT (-2, 0.9, -4.6) COLOR red;\nPART RPS_BKR_RTB_A = BOX(W=0.9, H=1.9, L=0.9) IN CB_ICA AT (-1.6, 0, -2.4) COLOR 0x4b6584;\nPART RPS_BKR_RTBM_A = BOX(W=0.3, H=0.3, L=0.3) IN CB_ICA AT (-0.7, 1, -2.4) COLOR orange;\nPART RPS_BKR_RTBS_A = BOX(W=0.3, H=0.3, L=0.3) IN CB_ICA AT (-0.1, 1, -2.4) COLOR orange;\nPART RPS_PLC_PRES_B_TRIP = BOX(W=0.8, H=2.0, L=0.6) IN CB_ICB AT (1.6, 0, 2.6) COLOR 0x7b4fb5;\nPART RPS_SWC_MAN_B_TRIP = BOX(W=0.3, H=0.25, L=0.2) IN CB_MCR AT (2, 0.9, -4.6) COLOR red;\nPART RPS_BKR_RTB_B = BOX(W=0.9, H=1.9, L=0.9) IN CB_ICB AT (-1.6, 0, -2.4) COLOR 0x4b6584;\nPART RPS_BKR_RTBM_B = BOX(W=0.3, H=0.3, L=0.3) IN CB_ICB AT (-0.7, 1, -2.4) COLOR orange;\nPART RPS_BKR_RTBS_B = BOX(W=0.3, H=0.3, L=0.3) IN CB_ICB AT (-0.1, 1, -2.4) COLOR orange;\nPART RPS_RA_CRD_R01 = CYLINDER(D=0.16, H=1.1) IN UHS_STRUCT_POOL AT (0.55, 19.15, 0) COLOR gold NOLABEL;\nPART RPS_RA_CRD_R02 = CYLINDER(D=0.16, H=1.1) IN UHS_STRUCT_POOL AT (0.878, 19.15, 0.364) COLOR gold NOLABEL;\nPART RPS_RA_CRD_R03 = CYLINDER(D=0.16, H=1.1) IN UHS_STRUCT_POOL AT (0.389, 19.15, 0.389) COLOR gold NOLABEL;\nPART RPS_RA_CRD_R04 = CYLINDER(D=0.16, H=1.1) IN UHS_STRUCT_POOL AT (0.364, 19.15, 0.878) COLOR gold NOLABEL;\nPART RPS_RA_CRD_R05 = CYLINDER(D=0.16, H=1.1) IN UHS_STRUCT_POOL AT (0, 19.15, 0.55) COLOR gold NOLABEL;\nPART RPS_RA_CRD_R06 = CYLINDER(D=0.16, H=1.1) IN UHS_STRUCT_POOL AT (-0.364, 19.15, 0.878) COLOR gold NOLABEL;\nPART RPS_RA_CRD_R07 = CYLINDER(D=0.16, H=1.1) IN UHS_STRUCT_POOL AT (-0.389, 19.15, 0.389) COLOR gold NOLABEL;\nPART RPS_RA_CRD_R08 = CYLINDER(D=0.16, H=1.1) IN UHS_STRUCT_POOL AT (-0.878, 19.15, 0.364) COLOR gold NOLABEL;\nPART RPS_RA_CRD_R09 = CYLINDER(D=0.16, H=1.1) IN UHS_STRUCT_POOL AT (-0.55, 19.15, 0) COLOR gold NOLABEL;\nPART RPS_RA_CRD_R10 = CYLINDER(D=0.16, H=1.1) IN UHS_STRUCT_POOL AT (-0.878, 19.15, -0.364) COLOR gold NOLABEL;\nPART RPS_RA_CRD_R11 = CYLINDER(D=0.16, H=1.1) IN UHS_STRUCT_POOL AT (-0.389, 19.15, -0.389) COLOR gold NOLABEL;\nPART RPS_RA_CRD_R12 = CYLINDER(D=0.16, H=1.1) IN UHS_STRUCT_POOL AT (-0.364, 19.15, -0.878) COLOR gold NOLABEL;\nPART RPS_RA_CRD_R13 = CYLINDER(D=0.16, H=1.1) IN UHS_STRUCT_POOL AT (0, 19.15, -0.55) COLOR gold NOLABEL;\nPART RPS_RA_CRD_R14 = CYLINDER(D=0.16, H=1.1) IN UHS_STRUCT_POOL AT (0.364, 19.15, -0.878) COLOR gold NOLABEL;\nPART RPS_RA_CRD_R15 = CYLINDER(D=0.16, H=1.1) IN UHS_STRUCT_POOL AT (0.389, 19.15, -0.389) COLOR gold NOLABEL;\nPART RPS_RA_CRD_R16 = CYLINDER(D=0.16, H=1.1) IN UHS_STRUCT_POOL AT (0.878, 19.15, -0.364) COLOR gold NOLABEL;\nPART RPS_RA_ROD_R01 = ROD(D=0.1, L=3.6, UP=2.0) IN UHS_STRUCT_POOL AT (0.55, 3.2, 0) COLOR 0x4a4f57 NOLABEL;\nPART RPS_RA_ROD_R02 = ROD(D=0.1, L=3.6, UP=2.0) IN UHS_STRUCT_POOL AT (0.878, 3.2, 0.364) COLOR 0x4a4f57 NOLABEL;\nPART RPS_RA_ROD_R03 = ROD(D=0.1, L=3.6, UP=2.0) IN UHS_STRUCT_POOL AT (0.389, 3.2, 0.389) COLOR 0x4a4f57 NOLABEL;\nPART RPS_RA_ROD_R04 = ROD(D=0.1, L=3.6, UP=2.0) IN UHS_STRUCT_POOL AT (0.364, 3.2, 0.878) COLOR 0x4a4f57 NOLABEL;\nPART RPS_RA_ROD_R05 = ROD(D=0.1, L=3.6, UP=2.0) IN UHS_STRUCT_POOL AT (0, 3.2, 0.55) COLOR 0x4a4f57 NOLABEL;\nPART RPS_RA_ROD_R06 = ROD(D=0.1, L=3.6, UP=2.0) IN UHS_STRUCT_POOL AT (-0.364, 3.2, 0.878) COLOR 0x4a4f57 NOLABEL;\nPART RPS_RA_ROD_R07 = ROD(D=0.1, L=3.6, UP=2.0) IN UHS_STRUCT_POOL AT (-0.389, 3.2, 0.389) COLOR 0x4a4f57 NOLABEL;\nPART RPS_RA_ROD_R08 = ROD(D=0.1, L=3.6, UP=2.0) IN UHS_STRUCT_POOL AT (-0.878, 3.2, 0.364) COLOR 0x4a4f57 NOLABEL;\nPART RPS_RA_ROD_R09 = ROD(D=0.1, L=3.6, UP=2.0) IN UHS_STRUCT_POOL AT (-0.55, 3.2, 0) COLOR 0x4a4f57 NOLABEL;\nPART RPS_RA_ROD_R10 = ROD(D=0.1, L=3.6, UP=2.0) IN UHS_STRUCT_POOL AT (-0.878, 3.2, -0.364) COLOR 0x4a4f57 NOLABEL;\nPART RPS_RA_ROD_R11 = ROD(D=0.1, L=3.6, UP=2.0) IN UHS_STRUCT_POOL AT (-0.389, 3.2, -0.389) COLOR 0x4a4f57 NOLABEL;\nPART RPS_RA_ROD_R12 = ROD(D=0.1, L=3.6, UP=2.0) IN UHS_STRUCT_POOL AT (-0.364, 3.2, -0.878) COLOR 0x4a4f57 NOLABEL;\nPART RPS_RA_ROD_R13 = ROD(D=0.1, L=3.6, UP=2.0) IN UHS_STRUCT_POOL AT (0, 3.2, -0.55) COLOR 0x4a4f57 NOLABEL;\nPART RPS_RA_ROD_R14 = ROD(D=0.1, L=3.6, UP=2.0) IN UHS_STRUCT_POOL AT (0.364, 3.2, -0.878) COLOR 0x4a4f57 NOLABEL;\nPART RPS_RA_ROD_R15 = ROD(D=0.1, L=3.6, UP=2.0) IN UHS_STRUCT_POOL AT (0.389, 3.2, -0.389) COLOR 0x4a4f57 NOLABEL;\nPART RPS_RA_ROD_R16 = ROD(D=0.1, L=3.6, UP=2.0) IN UHS_STRUCT_POOL AT (0.878, 3.2, -0.364) COLOR 0x4a4f57 NOLABEL;\nALLOW RPS_RA_CRD_R01, RPS_RA_CRD_R02, RPS_RA_CRD_R03, RPS_RA_CRD_R04, RPS_RA_CRD_R05, RPS_RA_CRD_R06, RPS_RA_CRD_R07, RPS_RA_CRD_R08, RPS_RA_CRD_R09, RPS_RA_CRD_R10, RPS_RA_CRD_R11, RPS_RA_CRD_R12, RPS_RA_CRD_R13, RPS_RA_CRD_R14, RPS_RA_CRD_R15, RPS_RA_CRD_R16, RPS_RA_ROD_R01, RPS_RA_ROD_R02, RPS_RA_ROD_R03, RPS_RA_ROD_R04, RPS_RA_ROD_R05, RPS_RA_ROD_R06, RPS_RA_ROD_R07, RPS_RA_ROD_R08, RPS_RA_ROD_R09, RPS_RA_ROD_R10, RPS_RA_ROD_R11, RPS_RA_ROD_R12, RPS_RA_ROD_R13, RPS_RA_ROD_R14, RPS_RA_ROD_R15, RPS_RA_ROD_R16 WITH CNV-SHELL, CNV-HEAD, RPV-SHELL, RPV-HEAD;\nTEXT \"16 CRDMs on the containment head\" AT (-9, 21.0, 0) SIZE 0.9;\n\n# --- cables: power (red), DC (orange), MV (black) and control (purple), routed above the equipment ---\nPART RPS_CABLE_CCBL_A_TRIP = WIRE(D=0.025) FROM (2.326, 2.05, 27.6) THROUGH (2.326, 6.97, 27.6), (-0.909, 6.97, 27.6), (-0.909, 6.97, 22.6) TO (-0.909, 1.95, 22.6) COLOR purple;\nPART RPS_CABLE_CCBL_A_MTRIP = WIRE(D=0.025) FROM (-14.103, 1.2, 25.4) THROUGH (-14.103, 7.025, 25.4), (-0.806, 7.025, 25.4), (-0.806, 7.025, 22.6) TO (-0.806, 1.95, 22.6) COLOR purple;\nPART RPS_CABLE_DCBL_A_SHT = WIRE(D=0.045) FROM (7.857, 1.65, 22.2) THROUGH (7.857, 7.08, 22.2), (0.797, 7.08, 22.2), (0.797, 7.08, 22.6) TO (0.797, 1.35, 22.6) COLOR orange;\nPART RPS_CABLE_CCBL_B_TRIP = WIRE(D=0.025) FROM (2.326, 2.05, 37.6) THROUGH (2.326, 7.135, 37.6), (-0.909, 7.135, 37.6), (-0.909, 7.135, 32.6) TO (-0.909, 1.95, 32.6) COLOR purple;\nPART RPS_CABLE_CCBL_B_MTRIP = WIRE(D=0.025) FROM (-10.103, 1.2, 25.4) THROUGH (-10.103, 7.19, 25.4), (-0.806, 7.19, 25.4), (-0.806, 7.19, 32.6) TO (-0.806, 1.95, 32.6) COLOR purple;\nPART RPS_CABLE_DCBL_B_SHT = WIRE(D=0.045) FROM (7.857, 1.65, 32.2) THROUGH (7.857, 7.245, 32.2), (0.797, 7.245, 32.2), (0.797, 7.245, 32.6) TO (0.797, 1.35, 32.6) COLOR orange;\nALLOW RPS_CABLE_* WITH RXB, RXB_GALLERY, RXB_CVCS, CB, CB_MCR, CB_ICA, CB_ICB, CB_DCA, CB_DCB, CB_HVACA, CB_HVACB, EB, EB_MV, EB_LVA, EB_LVB, EB_BESSA, EB_BESSB, AUX, AUX_CCW, TGB, TGB_FW, UHS_STRUCT_POOL;\nALLOW RPS_CABLE_* WITH RPS_CABLE_*;\n# cables of other systems share the same overhead raceways and risers\nALLOW RPS_CABLE_* WITH OSP_CABLE_MVCBL_UAT, EPA_CABLE_MVCBL_A_XFMR, EPA_CABLE_PCBL_A_BESS, EPB_CABLE_MVCBL_B_XFMR, EPB_CABLE_PCBL_B_BESS, DCA_CABLE_DCBL_A_BAT, DCA_CABLE_PCBL_A_BCH, DCB_CABLE_DCBL_B_BAT, DCB_CABLE_PCBL_B_BCH, SEN_CABLE_CCBL_1, SEN_CABLE_CCBL_2, SEN_CABLE_CCBL_3;\nALLOW RPS_CABLE_* WITH SEN_CABLE_CCBL_4, ESA_CABLE_DCBL_A_ESF, ESB_CABLE_DCBL_B_ESF, ECCS_CABLE_CCBL_RVV1A, ECCS_CABLE_CCBL_RVV1B, ECCS_CABLE_CCBL_RVV2A, ECCS_CABLE_CCBL_RVV2B, ECCS_CABLE_CCBL_RVV3A, ECCS_CABLE_CCBL_RVV3B, ECCS_CABLE_CCBL_RRV1A, ECCS_CABLE_CCBL_RRV1B, ECCS_CABLE_CCBL_RRV2A;\nALLOW RPS_CABLE_* WITH ECCS_CABLE_CCBL_RRV2B, DHRS_CABLE_CCBL_A_AV1, DHRS_CABLE_CCBL_A_AV2, DHRS_CABLE_CCBL_A_MDHRS, DHRS_CABLE_CCBL_B_AV1, DHRS_CABLE_CCBL_B_AV2, DHRS_CABLE_CCBL_B_MDHRS, CIS_CABLE_PCBL_A_MSI, CIS_CABLE_CCBL_A_MSI, CIS_CABLE_PCBL_B_MSO, CIS_CABLE_CCBL_B_MSO, CIS_CABLE_PCBL_A_FWI;\nALLOW RPS_CABLE_* WITH CIS_CABLE_CCBL_A_FWI, CIS_CABLE_PCBL_B_FWO, CIS_CABLE_CCBL_B_FWO, CIS_CABLE_PCBL_A_INJI, CIS_CABLE_CCBL_A_INJI, CIS_CABLE_PCBL_B_INJO, CIS_CABLE_CCBL_B_INJO, CIS_CABLE_PCBL_A_LTDI, CIS_CABLE_CCBL_A_LTDI, CIS_CABLE_PCBL_B_LTDO, CIS_CABLE_CCBL_B_LTDO, CVCS_CABLE_PCBL_A;\nALLOW RPS_CABLE_* WITH CVCS_CABLE_PCBL_B, CVCS_CABLE_CCBL_B, CCW_CABLE_PCBL_A_PMP, CCW_CABLE_PCBL_B_PMP, CCW_CABLE_PCBL_A_FAN, CCW_CABLE_PCBL_B_FAN, CCW_CABLE_CCBL_B_PMP, CCW_CABLE_CCBL_B_FAN, CRV_CABLE_PCBL_A_AHU, CRV_CABLE_PCBL_B_AHU, CRV_CABLE_PCBL_A_CHL, CRV_CABLE_PCBL_B_CHL;\nALLOW RPS_CABLE_* WITH CRV_CABLE_PCBL_A_DMP, CRV_CABLE_PCBL_B_DMP, CRV_CABLE_CCBL_B_START, FWS_CABLE_PCBL_COND, FWS_CABLE_MVCBL_A_FWP, FWS_CABLE_MVCBL_B_FWP, FWS_CABLE_CCBL_B_FWP;\n"
      },
