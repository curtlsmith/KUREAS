      "view3d": {
        "script": "# Component Cooling Water System (CCW): 3D layout of its SSCs in the HSMR-77 buildings.\n# Parts are named with the SSC controlled names, so each part (or GROUP) links to its SSC.\n# Rooms and buildings come from the Project 3D script; cables are WIREs routed through the rooms.\n\nPART CCW_TANK_TANK = TANK(D=1.6, H=2.4) IN AUX_CCW AT (-9.5, 0, 4.5) COLOR 0xb9c2cb;\nPART CCW_PUMP_MDP_A = PUMP(D=0.3, HEAD=40) IN AUX_CCW AT (-5.5, 0.62, -3);\nPART CCW_PUMP_MDP_B = PUMP(D=0.3, HEAD=40) IN AUX_CCW AT (-5.5, 0.62, 0.5);\nPART CCW_HTX_HTX = CYLINDER(D=1.2, H=5.0) IN AUX_CCW AT (4, 1, -2) DIR +X COLOR 0x8d99a6;\nPART CCW_PLC_FLOW = BOX(W=0.8, H=2.0, L=0.6) IN CB_MCR AT (6.5, 0, 5.8) COLOR 0x3f6f8f;\nPART X-CT-CELL-A = BOX(W=7, H=5.5, L=7.5) AT (82, 0, 29.0) COLOR concrete LABEL \"Cooling tower cell A\";\nPART CCW_CT_FAN_A = CYLINDER(D=4.6, H=1.6) IN X-CT-CELL-A AT (0, 5.5, 0) COLOR 0x8d99a6;\nPART X-CT-CELL-B = BOX(W=7, H=5.5, L=7.5) AT (82, 0, 38.0) COLOR concrete LABEL \"Cooling tower cell B\";\nPART CCW_CT_FAN_B = CYLINDER(D=4.6, H=1.6) IN X-CT-CELL-B AT (0, 5.5, 0) COLOR 0x8d99a6;\n# --- CCW supply and return headers (closed loop) ---\nPART CCW_PIPE_NPIPE-S1 = PIPE(D=0.3, L=8.9) AT (43, 0.5, 37.5) DIR -Z COLOR steel NOLABEL;\nPART CCW_PIPE_NPIPE-S2 = PIPE(D=0.3, L=19.5) AT (43, 0.5, 28.6) DIR +X COLOR steel NOLABEL;\nPART CCW_PIPE_NPIPE-S3 = PIPE(D=0.3, L=15.3) AT (62.5, 0.5, 28.6) DIR +X COLOR steel NOLABEL;\nPART CCW_PIPE_NPIPE-S4 = PIPE(D=0.3, L=15.3) AT (77.8, 1.1, 38) DIR -X COLOR steel NOLABEL;\nPART CCW_PIPE_NPIPE-S5 = PIPE(D=0.3, L=18.9) AT (62.5, 1.1, 38) DIR -X COLOR steel NOLABEL;\nPART CCW_PIPE_NPIPE-S6 = PIPE(D=0.3, L=0.4) AT (43.6, 1.1, 38) DIR -Z COLOR steel NOLABEL;\nGROUP CCW_PIPE_NPIPE = CCW_PIPE_NPIPE-S1, CCW_PIPE_NPIPE-S2, CCW_PIPE_NPIPE-S3, CCW_PIPE_NPIPE-S4, CCW_PIPE_NPIPE-S5, CCW_PIPE_NPIPE-S6;\nJOIN CCW_PIPE_NPIPE;\n\n# --- cables: power (red), DC (orange), MV (black) and control (purple), routed above the equipment ---\nPART CCW_CABLE_PCBL_A_PMP = WIRE(D=0.05) FROM (44.36, 2.35, 0.5) THROUGH (44.36, 7.135, 0.5), (45.291, 7.135, 0.5), (45.291, 7.135, 31) TO (45.291, 1, 31) COLOR red;\nPART CCW_CABLE_PCBL_B_PMP = WIRE(D=0.05) FROM (58.36, 2.35, 0.5) THROUGH (58.36, 7.19, 0.5), (45.291, 7.19, 0.5), (45.291, 7.19, 34.5) TO (45.291, 1, 34.5) COLOR red;\nPART CCW_CABLE_PCBL_A_FAN = WIRE(D=0.05) FROM (43.64, 2.35, 0.6) THROUGH (43.64, 7.245, 0.6), (83.057, 7.245, 0.6), (83.057, 7.245, 29) TO (83.057, 7.15, 29) COLOR red;\nPART CCW_CABLE_PCBL_B_FAN = WIRE(D=0.05) FROM (57.64, 2.35, 0.6) THROUGH (57.64, 7.3, 0.6), (83.057, 7.3, 0.6), (83.057, 7.3, 38) TO (83.057, 7.15, 38) COLOR red;\nPART CCW_CABLE_CCBL_B_PMP = WIRE(D=0.025) FROM (-5.774, 2.05, 35.8) THROUGH (-5.774, 7.355, 35.8), (45.342, 7.355, 35.8), (45.342, 7.355, 34.5) TO (45.342, 1, 34.5) COLOR purple;\nPART CCW_CABLE_CCBL_B_FAN = WIRE(D=0.025) FROM (-5.683, 2.05, 35.8) THROUGH (-5.683, 7.41, 35.8), (83.171, 7.41, 35.8), (83.171, 7.41, 38) TO (83.171, 7.15, 38) COLOR purple;\nALLOW CCW_CABLE_* WITH RXB, RXB_GALLERY, RXB_CVCS, CB, CB_MCR, CB_ICA, CB_ICB, CB_DCA, CB_DCB, CB_HVACA, CB_HVACB, EB, EB_MV, EB_LVA, EB_LVB, EB_BESSA, EB_BESSB, AUX, AUX_CCW, TGB, TGB_FW, UHS_STRUCT_POOL;\nALLOW CCW_CABLE_* WITH CCW_CABLE_*;\n# cables of other systems share the same overhead raceways and risers\nALLOW CCW_CABLE_* WITH OSP_CABLE_MVCBL_UAT, EPA_CABLE_MVCBL_A_XFMR, EPA_CABLE_PCBL_A_BESS, EPB_CABLE_MVCBL_B_XFMR, EPB_CABLE_PCBL_B_BESS, DCA_CABLE_DCBL_A_BAT, DCA_CABLE_PCBL_A_BCH, DCB_CABLE_DCBL_B_BAT, DCB_CABLE_PCBL_B_BCH, SEN_CABLE_CCBL_1, SEN_CABLE_CCBL_2, SEN_CABLE_CCBL_3;\nALLOW CCW_CABLE_* WITH SEN_CABLE_CCBL_4, RPS_CABLE_CCBL_A_TRIP, RPS_CABLE_CCBL_A_MTRIP, RPS_CABLE_DCBL_A_SHT, RPS_CABLE_CCBL_B_TRIP, RPS_CABLE_CCBL_B_MTRIP, RPS_CABLE_DCBL_B_SHT, ESA_CABLE_DCBL_A_ESF, ESB_CABLE_DCBL_B_ESF, ECCS_CABLE_CCBL_RVV1A, ECCS_CABLE_CCBL_RVV1B, ECCS_CABLE_CCBL_RVV2A;\nALLOW CCW_CABLE_* WITH ECCS_CABLE_CCBL_RVV2B, ECCS_CABLE_CCBL_RVV3A, ECCS_CABLE_CCBL_RVV3B, ECCS_CABLE_CCBL_RRV1A, ECCS_CABLE_CCBL_RRV1B, ECCS_CABLE_CCBL_RRV2A, ECCS_CABLE_CCBL_RRV2B, DHRS_CABLE_CCBL_A_AV1, DHRS_CABLE_CCBL_A_AV2, DHRS_CABLE_CCBL_A_MDHRS, DHRS_CABLE_CCBL_B_AV1, DHRS_CABLE_CCBL_B_AV2;\nALLOW CCW_CABLE_* WITH DHRS_CABLE_CCBL_B_MDHRS, CIS_CABLE_PCBL_A_MSI, CIS_CABLE_CCBL_A_MSI, CIS_CABLE_PCBL_B_MSO, CIS_CABLE_CCBL_B_MSO, CIS_CABLE_PCBL_A_FWI, CIS_CABLE_CCBL_A_FWI, CIS_CABLE_PCBL_B_FWO, CIS_CABLE_CCBL_B_FWO, CIS_CABLE_PCBL_A_INJI, CIS_CABLE_CCBL_A_INJI, CIS_CABLE_PCBL_B_INJO;\nALLOW CCW_CABLE_* WITH CIS_CABLE_CCBL_B_INJO, CIS_CABLE_PCBL_A_LTDI, CIS_CABLE_CCBL_A_LTDI, CIS_CABLE_PCBL_B_LTDO, CIS_CABLE_CCBL_B_LTDO, CVCS_CABLE_PCBL_A, CVCS_CABLE_PCBL_B, CVCS_CABLE_CCBL_B, CRV_CABLE_PCBL_A_AHU, CRV_CABLE_PCBL_B_AHU, CRV_CABLE_PCBL_A_CHL, CRV_CABLE_PCBL_B_CHL;\nALLOW CCW_CABLE_* WITH CRV_CABLE_PCBL_A_DMP, CRV_CABLE_PCBL_B_DMP, CRV_CABLE_CCBL_B_START, FWS_CABLE_PCBL_COND, FWS_CABLE_MVCBL_A_FWP, FWS_CABLE_MVCBL_B_FWP, FWS_CABLE_CCBL_B_FWP;\nALLOW CCW_PIPE_NPIPE WITH RXB, RXB_GALLERY, RXB_CVCS, CB, CB_MCR, CB_ICA, CB_ICB, CB_DCA, CB_DCB, CB_HVACA, CB_HVACB, EB, EB_MV, EB_LVA, EB_LVB, EB_BESSA, EB_BESSB, AUX, AUX_CCW, TGB, TGB_FW, UHS_STRUCT_POOL;\nALLOW CCW_PIPE_NPIPE WITH CCW_TANK_TANK, CCW_PUMP_MDP_A, CCW_PUMP_MDP_B, CCW_HTX_HTX, X-CT-CELL-A, X-CT-CELL-B;\n\n# --- leak rates (NRC-INL 2020: Normal Pipe external leakage 2.5E-10 /h-ft, gamma 0.5; Tank external leakage 1.2E-7 /h, gamma 0.5).\n#     MISSION is the 72-h mission (72-h file) or the restoration time (1-yr file: pipe 168 h, tank 336 h). ---\nLEAKRATE LR-CCW-TNK ON CCW_TANK_TANK RATE 1.2E-7 PER HOUR PER PART GAMMA 0.5 MISSION 72 HOURS FLUID WATER IGNITES NO;\nLEAKRATE LR-CCW-PIPE ON CCW_PIPE_NPIPE RATE 2.5E-10 PER HOUR PER FT GAMMA 0.5 MISSION 72 HOURS FLUID WATER IGNITES NO;\n"
