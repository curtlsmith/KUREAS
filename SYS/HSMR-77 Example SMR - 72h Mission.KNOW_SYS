              "effects": [
                {
                  "description": "Local: gross rupture of the pressure boundary"
                },
                {
                  "description": "System: Coolant is not retained for recirculation; ECCS fails"
                },
                {
                  "description": "Plant: No passive emergency core cooling after a loss of coolant or a loss of DHRS: core damage unless another means of cooling exists"
                },
                {
                  "description": "Detection: annunciated or found by routine monitoring; repair started at once"
                }
              ],
              "tplFm": "EXRUPT"
            }
          ],
          "pidSymbol": "containment",
          "ccf": {
