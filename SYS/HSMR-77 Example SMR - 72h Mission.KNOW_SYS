      "view3d": {
        "script": "# Chemical and Volume Control System (makeup) (CVCS): 3D layout of its SSCs in the HSMR-77 buildings.\n# Parts are named with the SSC controlled names, so each part (or GROUP) links to its SSC.\n# Rooms and buildings come from the Project 3D script; cables are WIREs routed through the rooms.\n\nPART CVCS_TANK_TANK = TANK(D=2.6, H=3.6) IN RXB_CVCS AT (-2.8, 0, 3.2) COLOR 0xb9c2cb;\nPART CVCS_PUMP_MDP_A = PUMP(D=0.2, HEAD=80) IN RXB_CVCS AT (-1.5, 0.45, -1);\nPART CVCS_PUMP_MDP_B = PUMP(D=0.2, HEAD=80) IN RXB_CVCS AT (-1.5, 0.45, -3.5);\nPART CVCS_VALVE_CKV_A = VALVE(D=0.15) IN RXB_CVCS AT (1.2, 0.9, -0.55);\nPART CVCS_VALVE_CKV_B = VALVE(D=0.15) IN RXB_CVCS AT (1.2, 0.9, -3.05);\nPART CVCS_PLC_FLOW = BOX(W=0.8, H=2.0, L=0.6) IN CB_MCR AT (5.5, 0, 5.8) COLOR 0x3f6f8f;\n# --- CVCS suction header, makeup tank to both pumps ---\nPART CVCS_PIPE_NPIPE_SUC-S1 = PIPE(D=0.15, L=5.35) AT (10.7, 0.25, 9.85) DIR -Z COLOR steel NOLABEL;\nPART CVCS_PIPE_NPIPE_SUC-S2 = PIPE(D=0.15, L=1.2) AT (10.75, 0.45, 7) DIR +X COLOR steel NOLABEL;\nPART CVCS_PIPE_NPIPE_SUC-S3 = PIPE(D=0.15, L=1.2) AT (10.75, 0.45, 4.5) DIR +X COLOR steel NOLABEL;\nGROUP CVCS_PIPE_NPIPE_SUC = CVCS_PIPE_NPIPE_SUC-S1, CVCS_PIPE_NPIPE_SUC-S2, CVCS_PIPE_NPIPE_SUC-S3;\nJOIN CVCS_PIPE_NPIPE_SUC;\n# --- CVCS discharge header to the RPV injection penetration ---\nPART CVCS_PIPE_NPIPE_DIS-S1 = PIPE(D=0.12, L=0.55) AT (15.25, 0.9, 7.45) DIR +X COLOR steel NOLABEL;\nPART CVCS_PIPE_NPIPE_DIS-S2 = PIPE(D=0.12, L=4.65) AT (15.8, 0.9, 7.45) DIR -Z COLOR steel NOLABEL;\nPART CVCS_PIPE_NPIPE_DIS-S3 = PIPE(D=0.12, L=11.6) AT (15.8, 0.9, 2.8) DIR -X COLOR steel NOLABEL;\nPART CVCS_PIPE_NPIPE_DIS-S4 = PIPE(D=0.12, L=0.5) AT (15.25, 0.9, 4.95) DIR +X COLOR steel NOLABEL;\nGROUP CVCS_PIPE_NPIPE_DIS = CVCS_PIPE_NPIPE_DIS-S1, CVCS_PIPE_NPIPE_DIS-S2, CVCS_PIPE_NPIPE_DIS-S3, CVCS_PIPE_NPIPE_DIS-S4;\nJOIN CVCS_PIPE_NPIPE_DIS;\n\n# --- cables: power (red), DC (orange), MV (black) and control (purple), routed above the equipment ---\nPART CVCS_CABLE_PCBL_A = WIRE(D=0.05) FROM (44.24, 2.35, 0.5) THROUGH (44.24, 6.97, 0.5), (12.527, 6.97, 0.5), (12.527, 6.97, 7) TO (12.527, 0.72, 7) COLOR red;\nPART CVCS_CABLE_PCBL_B = WIRE(D=0.05) FROM (58.24, 2.35, 0.5) THROUGH (58.24, 7.025, 0.5), (12.527, 7.025, 0.5), (12.527, 7.025, 4.5) TO (12.527, 0.72, 4.5) COLOR red;\nPART CVCS_CABLE_CCBL_B = WIRE(D=0.025) FROM (-6.774, 2.05, 35.8) THROUGH (-6.774, 7.08, 35.8), (12.561, 7.08, 35.8), (12.561, 7.08, 4.5) TO (12.561, 0.72, 4.5) COLOR purple;\nALLOW CVCS_CABLE_* WITH RXB, RXB_GALLERY, RXB_CVCS, CB, CB_MCR, CB_ICA, CB_ICB, CB_DCA, CB_DCB, CB_HVACA, CB_HVACB, EB, EB_MV, EB_LVA, EB_LVB, EB_BESSA, EB_BESSB, AUX, AUX_CCW, TGB, TGB_FW, UHS_STRUCT_POOL;\nALLOW CVCS_CABLE_* WITH CVCS_CABLE_*;\n# cables of other systems share the same overhead raceways and risers\nALLOW CVCS_CABLE_* WITH OSP_CABLE_MVCBL_UAT, EPA_CABLE_MVCBL_A_XFMR, EPA_CABLE_PCBL_A_BESS, EPB_CABLE_MVCBL_B_XFMR, EPB_CABLE_PCBL_B_BESS, DCA_CABLE_DCBL_A_BAT, DCA_CABLE_PCBL_A_BCH, DCB_CABLE_DCBL_B_BAT, DCB_CABLE_PCBL_B_BCH, SEN_CABLE_CCBL_1, SEN_CABLE_CCBL_2, SEN_CABLE_CCBL_3;\nALLOW CVCS_CABLE_* WITH SEN_CABLE_CCBL_4, RPS_CABLE_CCBL_A_TRIP, RPS_CABLE_CCBL_A_MTRIP, RPS_CABLE_DCBL_A_SHT, RPS_CABLE_CCBL_B_TRIP, RPS_CABLE_CCBL_B_MTRIP, RPS_CABLE_DCBL_B_SHT, ESA_CABLE_DCBL_A_ESF, ESB_CABLE_DCBL_B_ESF, ECCS_CABLE_CCBL_RVV1A, ECCS_CABLE_CCBL_RVV1B, ECCS_CABLE_CCBL_RVV2A;\nALLOW CVCS_CABLE_* WITH ECCS_CABLE_CCBL_RVV2B, ECCS_CABLE_CCBL_RVV3A, ECCS_CABLE_CCBL_RVV3B, ECCS_CABLE_CCBL_RRV1A, ECCS_CABLE_CCBL_RRV1B, ECCS_CABLE_CCBL_RRV2A, ECCS_CABLE_CCBL_RRV2B, DHRS_CABLE_CCBL_A_AV1, DHRS_CABLE_CCBL_A_AV2, DHRS_CABLE_CCBL_A_MDHRS, DHRS_CABLE_CCBL_B_AV1, DHRS_CABLE_CCBL_B_AV2;\nALLOW CVCS_CABLE_* WITH DHRS_CABLE_CCBL_B_MDHRS, CIS_CABLE_PCBL_A_MSI, CIS_CABLE_CCBL_A_MSI, CIS_CABLE_PCBL_B_MSO, CIS_CABLE_CCBL_B_MSO, CIS_CABLE_PCBL_A_FWI, CIS_CABLE_CCBL_A_FWI, CIS_CABLE_PCBL_B_FWO, CIS_CABLE_CCBL_B_FWO, CIS_CABLE_PCBL_A_INJI, CIS_CABLE_CCBL_A_INJI, CIS_CABLE_PCBL_B_INJO;\nALLOW CVCS_CABLE_* WITH CIS_CABLE_CCBL_B_INJO, CIS_CABLE_PCBL_A_LTDI, CIS_CABLE_CCBL_A_LTDI, CIS_CABLE_PCBL_B_LTDO, CIS_CABLE_CCBL_B_LTDO, CCW_CABLE_PCBL_A_PMP, CCW_CABLE_PCBL_B_PMP, CCW_CABLE_PCBL_A_FAN, CCW_CABLE_PCBL_B_FAN, CCW_CABLE_CCBL_B_PMP, CCW_CABLE_CCBL_B_FAN, CRV_CABLE_PCBL_A_AHU;\nALLOW CVCS_CABLE_* WITH CRV_CABLE_PCBL_B_AHU, CRV_CABLE_PCBL_A_CHL, CRV_CABLE_PCBL_B_CHL, CRV_CABLE_PCBL_A_DMP, CRV_CABLE_PCBL_B_DMP, CRV_CABLE_CCBL_B_START, FWS_CABLE_PCBL_COND, FWS_CABLE_MVCBL_A_FWP, FWS_CABLE_MVCBL_B_FWP, FWS_CABLE_CCBL_B_FWP;\nALLOW CVCS_PIPE_NPIPE_SUC, CVCS_PIPE_NPIPE_DIS WITH RXB, RXB_GALLERY, RXB_CVCS, CB, CB_MCR, CB_ICA, CB_ICB, CB_DCA, CB_DCB, CB_HVACA, CB_HVACB, EB, EB_MV, EB_LVA, EB_LVB, EB_BESSA, EB_BESSB, AUX, AUX_CCW, TGB, TGB_FW, UHS_STRUCT_POOL;\nALLOW CVCS_PIPE_NPIPE_SUC, CVCS_PIPE_NPIPE_DIS WITH CVCS_TANK_TANK, CVCS_PUMP_MDP_A, CVCS_PUMP_MDP_B, CVCS_VALVE_CKV_A, CVCS_VALVE_CKV_B;\nALLOW CVCS_PIPE_NPIPE_SUC, CVCS_PIPE_NPIPE_DIS WITH CVCS_PIPE_NPIPE_SUC, CVCS_PIPE_NPIPE_DIS;\n\n# --- leak rates (NRC-INL 2020: Normal Pipe external leakage 2.5E-10 /h-ft, gamma 0.5; Tank external leakage 1.2E-7 /h, gamma 0.5).\n#     MISSION is the 72-h mission (72-h file) or the restoration time (1-yr file: pipe 168 h, tank 336 h). ---\nLEAKRATE LR-CVCS-TNK ON CVCS_TANK_TANK RATE 1.2E-7 PER HOUR PER PART GAMMA 0.5 MISSION 72 HOURS FLUID WATER IGNITES NO;\nLEAKRATE LR-CVCS-PIPE-SUC ON CVCS_PIPE_NPIPE_SUC RATE 2.5E-10 PER HOUR PER FT GAMMA 0.5 MISSION 72 HOURS FLUID WATER IGNITES NO;\nLEAKRATE LR-CVCS-PIPE-DIS ON CVCS_PIPE_NPIPE_DIS RATE 2.5E-10 PER HOUR PER FT GAMMA 0.5 MISSION 72 HOURS FLUID WATER IGNITES NO;\n"
      },
