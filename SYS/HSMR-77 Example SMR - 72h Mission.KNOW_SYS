    {
      "id": "sys_hsmr_uhs",
      "name": "Ultimate Heat Sink (Reactor Pool)",
      "acronym": "UHS",
      "description": "<h3>Function</h3><p>The reactor pool is the ultimate heat sink (UHS) of HSMR-77. The containment vessel and the two DHRS passive condensers are\nsubmerged in it, so decay heat reaches the pool by conduction through the containment wall (ECCS mode) or by the DHRS natural-circulation loops.</p>\n<h3>Configuration</h3><p>Reinforced-concrete pool (22 m &times; 28 m &times; 20 m) with a stainless liner inside the Reactor Building; about 6,000 m<sup>3</sup> of water.</p>\n<h3>Success criterion</h3><p>The pool holds its inventory (structure and liner intact).</p>\n<h3>Leakage</h3><p>A liner leak rate is assigned with LEAKRATE on the pool in the UHS 3D script (gives the LEAK failure mode).</p>\n<h3>Seismic</h3><p>The pool uses the NUREG/CR-3558 Table 3 reactor building wall shear fragility (Am = 4.0 g).</p>",
      "sscsInSystem": [
        {
          "id": 1790000000271,
          "name": "UHS_STRUCT_POOL",
          "savedId": "UHS-POOL",
          "description": "Reactor pool: reinforced concrete with stainless steel liner, about 6,000 m3 of water (the ultimate heat sink)",
          "label": "Reactor Pool (POOL)",
          "sscType": "Structure (STRUCT)",
          "system": "Ultimate Heat Sink (Reactor Pool)",
          "uniqueLabel": "",
          "trainId": "",
          "moduleId": "",
          "templateId": "tpl_hsmr_pool",
          "source": {
            "id": "HSMR-ILLUS",
            "name": "HSMR-77 illustrative value",
            "description": "Engineering judgment for this hypothetical example (no built-in data); replace with design-specific or plant-specific data"
          },
          "failureModes": [
            {
              "id": 1790000000018,
              "mode": "STRFAIL",
              "probabilityType": "probability",
              "applicable": true,
              "lambda": "1.00E-09",
              "failureModel": "2",
              "missionTime": "72",
              "data": {
                "system": "",
                "ssc_type": "Structure (STRUCT)",
                "component_type": "Reactor Pool (POOL)",
                "failure_mode": "Structural Failure (STRFAIL)",
                "description": "Pool structure or liner fails so that the pool cannot hold its inventory (illustrative structural rate).",
                "units": "h",
                "mean": "1.00E-09",
                "distribution_type": "Lognormal",
                "distribution_shape_parameter": "1.00E-09",
                "distribution_scale_parameter": "10"
              },
              "source": "HSMR-77 illustrative value — Engineering judgment for this hypothetical example (no built-in data); replace with design-specific or plant-specific data",
              "sourceRef": {
                "id": "HSMR-ILLUS",
                "name": "HSMR-77 illustrative value",
                "description": "Engineering judgment for this hypothetical example (no built-in data); replace with design-specific or plant-specific data"
              },
              "effects": [
                {
                  "description": "Local: the structure no longer holds the pool inventory"
                },
                {
                  "description": "System: The containment vessel and the DHRS condensers lose their heat sink"
                },
                {
                  "description": "Plant: No heat sink for DHRS or ECCS (passive core cooling lost)"
                },
                {
                  "description": "Detection: annunciated or found by routine monitoring; repair started at once"
                }
              ],
              "tplFm": "STRFAIL"
            }
          ],
          "pidSymbol": "spent-fuel-pool",
          "ccf": {
            "use": "none"
          }
        }
      ],
      "boundaryConditions": [],
      "systemLogic": [
        {
          "type": "comment",
          "value": "# Ultimate heat sink (UHS): the reactor pool in the Reactor Building",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "'''",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@source { HSMR-77-SDD Reactor pool: the module is submerged; the pool absorbs decay heat for more than 30 days without",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "  makeup or pool cooling. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@boundary { The pool structure and liner. Pool cooling and cleanup and pool makeup are outside the boundary. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@basis { DHRS and ECCS reject decay heat to the pool; the pool works if it holds its inventory. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@assumption key { The pool inventory alone is sufficient for the 72-hour mission and for the 1-year unavailability",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "  measure (no pool cooling is needed to perform the safety function). }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@assumption verify { The structural failure rate is illustrative (HSMR-ILLUS). The liner leak rate is entered as a",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "  LEAKRATE on the pool in the 3D script. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@modeler CLS 2026-10-13 { A one-SSC support system so that DHRS and ECCS share the pool through SUBSYS(UHS). }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "'''",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "# @exclusion { Pool cooling (2 x 100 % pumps) and pool makeup are not required for the 72-hour function and are excluded. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
