      "view3d": {
        "script": "# Main Feedwater (normal heat removal) (FWS): 3D layout of its SSCs in the HSMR-77 buildings.\n# Parts are named with the SSC controlled names, so each part (or GROUP) links to its SSC.\n# Rooms and buildings come from the Project 3D script; cables are WIREs routed through the rooms.\n\nPART FWS_TANK_TANK_HW = TANK(D=2.8, H=3.0) IN TGB_FW AT (-6, 0, 2.5) COLOR 0xb9c2cb;\nPART FWS_PUMP_MDP_COND = PUMP(D=0.3, HEAD=50) IN TGB_FW AT (-3, 0.62, 2.5);\nPART FWS_PUMP_MDP_A_FWP = PUMP(D=0.4, HEAD=150) IN TGB_FW AT (1, 0.81, -2);\nPART FWS_PUMP_MDP_B_FWP = PUMP(D=0.4, HEAD=150) IN TGB_FW AT (1, 0.81, -4.5);\nPART FWS_PLC_FLOW_FW = BOX(W=0.8, H=2.0, L=0.6) IN CB_MCR AT (4.5, 0, 5.8) COLOR 0x3f6f8f;\nPART FWS_VALVE_FCV_FRV = VALVE(D=0.3) IN TGB_FW AT (5.5, 1.2, -3.2);\n# --- Feedwater header from the Turbine Building to the Reactor Building (to the containment penetration) ---\nPART FWS_PIPE_NPIPE_FW-S1 = PIPE(D=0.35, L=1.9) AT (-50.4, 1.2, -12.2) DIR +X COLOR steel NOLABEL;\nPART FWS_PIPE_NPIPE_FW-S2 = PIPE(D=0.35, L=7.4) AT (-48.5, 1.2, -12.2) DIR -Z COLOR steel NOLABEL;\nPART FWS_PIPE_NPIPE_FW-S3 = PIPE(D=0.35, L=24.5) AT (-48.5, 1.2, -19.6) DIR +X COLOR steel NOLABEL;\nPART FWS_PIPE_NPIPE_FW-S4 = PIPE(D=0.35, L=4.8) AT (-24, 1.2, -19.6) DIR +Z COLOR steel NOLABEL;\nPART FWS_PIPE_NPIPE_FW-S5 = PIPE(D=0.35, L=1.4) AT (-24, 1.2, -14.8) DIR +X COLOR steel NOLABEL;\nGROUP FWS_PIPE_NPIPE_FW = FWS_PIPE_NPIPE_FW-S1, FWS_PIPE_NPIPE_FW-S2, FWS_PIPE_NPIPE_FW-S3, FWS_PIPE_NPIPE_FW-S4, FWS_PIPE_NPIPE_FW-S5;\nJOIN FWS_PIPE_NPIPE_FW;\n\n# --- cables: power (red), DC (orange), MV (black) and control (purple), routed above the equipment ---\nPART FWS_CABLE_PCBL_COND = WIRE(D=0.05) FROM (44.12, 2.35, 0.6) THROUGH (44.12, 7.85, 0.6), (44.12, 7.85, -19.4), (-59.209, 7.85, -19.4), (-59.209, 7.85, -6.5) TO (-59.209, 1, -6.5) COLOR red;\nPART FWS_CABLE_MVCBL_A_FWP = WIRE(D=0.08) FROM (49.64, 2.45, -12.5) THROUGH (49.64, 7.905, -12.5), (49.64, 7.905, -19.45), (-54.946, 7.905, -19.45), (-54.946, 7.905, -11) TO (-54.946, 1.3, -11) COLOR black;\nPART FWS_CABLE_MVCBL_B_FWP = WIRE(D=0.08) FROM (49.76, 2.45, -12.5) THROUGH (49.76, 7.96, -12.5), (49.76, 7.96, -19.5), (-54.946, 7.96, -19.5), (-54.946, 7.96, -13.5) TO (-54.946, 1.3, -13.5) COLOR black;\nPART FWS_CABLE_CCBL_B_FWP = WIRE(D=0.025) FROM (-7.774, 2.05, 35.8) THROUGH (-7.774, 8.015, 35.8), (-54.877, 8.015, 35.8), (-54.877, 8.015, -13.5) TO (-54.877, 1.3, -13.5) COLOR purple;\nALLOW FWS_CABLE_* WITH RXB, RXB_GALLERY, RXB_CVCS, CB, CB_MCR, CB_ICA, CB_ICB, CB_DCA, CB_DCB, CB_HVACA, CB_HVACB, EB, EB_MV, EB_LVA, EB_LVB, EB_BESSA, EB_BESSB, AUX, AUX_CCW, TGB, TGB_FW, UHS_STRUCT_POOL;\nALLOW FWS_CABLE_* WITH FWS_CABLE_*;\n# cables of other systems share the same overhead raceways and risers\nALLOW FWS_CABLE_* WITH OSP_CABLE_MVCBL_UAT, EPA_CABLE_MVCBL_A_XFMR, EPA_CABLE_PCBL_A_BESS, EPB_CABLE_MVCBL_B_XFMR, EPB_CABLE_PCBL_B_BESS, DCA_CABLE_DCBL_A_BAT, DCA_CABLE_PCBL_A_BCH, DCB_CABLE_DCBL_B_BAT, DCB_CABLE_PCBL_B_BCH, SEN_CABLE_CCBL_1, SEN_CABLE_CCBL_2, SEN_CABLE_CCBL_3;\nALLOW FWS_CABLE_* WITH SEN_CABLE_CCBL_4, RPS_CABLE_CCBL_A_TRIP, RPS_CABLE_CCBL_A_MTRIP, RPS_CABLE_DCBL_A_SHT, RPS_CABLE_CCBL_B_TRIP, RPS_CABLE_CCBL_B_MTRIP, RPS_CABLE_DCBL_B_SHT, ESA_CABLE_DCBL_A_ESF, ESB_CABLE_DCBL_B_ESF, ECCS_CABLE_CCBL_RVV1A, ECCS_CABLE_CCBL_RVV1B, ECCS_CABLE_CCBL_RVV2A;\nALLOW FWS_CABLE_* WITH ECCS_CABLE_CCBL_RVV2B, ECCS_CABLE_CCBL_RVV3A, ECCS_CABLE_CCBL_RVV3B, ECCS_CABLE_CCBL_RRV1A, ECCS_CABLE_CCBL_RRV1B, ECCS_CABLE_CCBL_RRV2A, ECCS_CABLE_CCBL_RRV2B, DHRS_CABLE_CCBL_A_AV1, DHRS_CABLE_CCBL_A_AV2, DHRS_CABLE_CCBL_A_MDHRS, DHRS_CABLE_CCBL_B_AV1, DHRS_CABLE_CCBL_B_AV2;\nALLOW FWS_CABLE_* WITH DHRS_CABLE_CCBL_B_MDHRS, CIS_CABLE_PCBL_A_MSI, CIS_CABLE_CCBL_A_MSI, CIS_CABLE_PCBL_B_MSO, CIS_CABLE_CCBL_B_MSO, CIS_CABLE_PCBL_A_FWI, CIS_CABLE_CCBL_A_FWI, CIS_CABLE_PCBL_B_FWO, CIS_CABLE_CCBL_B_FWO, CIS_CABLE_PCBL_A_INJI, CIS_CABLE_CCBL_A_INJI, CIS_CABLE_PCBL_B_INJO;\nALLOW FWS_CABLE_* WITH CIS_CABLE_CCBL_B_INJO, CIS_CABLE_PCBL_A_LTDI, CIS_CABLE_CCBL_A_LTDI, CIS_CABLE_PCBL_B_LTDO, CIS_CABLE_CCBL_B_LTDO, CVCS_CABLE_PCBL_A, CVCS_CABLE_PCBL_B, CVCS_CABLE_CCBL_B, CCW_CABLE_PCBL_A_PMP, CCW_CABLE_PCBL_B_PMP, CCW_CABLE_PCBL_A_FAN, CCW_CABLE_PCBL_B_FAN;\nALLOW FWS_CABLE_* WITH CCW_CABLE_CCBL_B_PMP, CCW_CABLE_CCBL_B_FAN, CRV_CABLE_PCBL_A_AHU, CRV_CABLE_PCBL_B_AHU, CRV_CABLE_PCBL_A_CHL, CRV_CABLE_PCBL_B_CHL, CRV_CABLE_PCBL_A_DMP, CRV_CABLE_PCBL_B_DMP, CRV_CABLE_CCBL_B_START;\nALLOW FWS_PIPE_NPIPE_FW WITH RXB, RXB_GALLERY, RXB_CVCS, CB, CB_MCR, CB_ICA, CB_ICB, CB_DCA, CB_DCB, CB_HVACA, CB_HVACB, EB, EB_MV, EB_LVA, EB_LVB, EB_BESSA, EB_BESSB, AUX, AUX_CCW, TGB, TGB_FW, UHS_STRUCT_POOL;\nALLOW FWS_PIPE_NPIPE_FW WITH FWS_VALVE_FCV_FRV, FWS_PUMP_MDP_A_FWP, FWS_PUMP_MDP_B_FWP, FWS_TANK_TANK_HW;\n\n# --- leak rates (NRC-INL 2020: Normal Pipe external leakage 2.5E-10 /h-ft, gamma 0.5; Tank external leakage 1.2E-7 /h, gamma 0.5).\n#     MISSION is the 72-h mission (72-h file) or the restoration time (1-yr file: pipe 168 h, tank 336 h). ---\nLEAKRATE LR-FWS-HW ON FWS_TANK_TANK_HW RATE 1.2E-7 PER HOUR PER PART GAMMA 0.5 MISSION 72 HOURS FLUID WATER IGNITES NO;\nLEAKRATE LR-FWS-PIPE ON FWS_PIPE_NPIPE_FW RATE 2.5E-10 PER HOUR PER FT GAMMA 0.5 MISSION 72 HOURS FLUID WATER IGNITES NO;\n"
      },
