    {
      "id": "sys_hsmr_cis",
      "name": "Containment Isolation System",
      "acronym": "CIS",
      "description": "<h3>Function</h3><p>The Containment Isolation System (CIS) closes the process lines that penetrate the containment vessel, to keep fission\nproducts inside and to form the closed DHRS loops (main steam and feedwater isolation).</p>\n<h3>Configuration</h3><p>Four penetrations (main steam, feedwater, CVCS injection, CVCS letdown), each with an inboard Division A and an outboard Division B\nmotor-operated isolation valve in the RXB piping gallery. Each valve has a power cable from its division MCC and an actuation cable from its ESFAS relay panel.</p>\n<h3>Success criterion</h3><p>Every penetration isolated by at least one of its two valves.</p>\n<h3>Dependencies</h3><p>ESA and EPA (Division A valves); ESB and EPB (Division B valves).</p>\n<h3>Common cause</h3><p>The eight isolation valves share one template, so one beta-factor CCF event fails all eight to close.</p>",
      "sscsInSystem": [
        {
          "id": 1790000000373,
          "name": "CIS_VALVE_MOV_A_MSI",
          "savedId": "CIS-CIV-MSI",
          "description": "Inboard containment isolation valve on the main steam header (Division A)",
          "label": "Motor-Operated Valve (MOV)",
          "sscType": "Valve (VALVE)",
          "system": "Containment Isolation System",
          "uniqueLabel": "MSI",
          "trainId": "Train A",
          "moduleId": "",
          "templateId": "tpl_hsmr_mov_c",
          "source": {
            "id": "NRC-INL-2020",
            "name": "NRC-INL 2020 Parameter Estimation",
            "description": "Industry Average Parameter Estimates, 2020 Update, URL https://nrcoe.inl.gov/avgperf/"
          },
          "failureModes": [
            {
              "id": 1790000000009,
              "mode": "FTC",
              "probabilityType": "probability",
              "applicable": true,
              "failureModel": "0",
              "data": {
                "system": "",
                "ssc_type": "Valve (VALVE)",
                "component_type": "Motor-Operated Valve (MOV)",
                "failure_mode": "Fails to Close (FTC)",
                "description": "Motor-Operated Valve (MOV) Fails to Close (FTC).",
                "units": "d",
                "mean": "2.30E-04",
                "distribution_type": "Beta",
                "distribution_shape_parameter": "0.97",
                "distribution_scale_parameter": "4.26E+03"
              },
              "source": "NRC-INL 2020 Parameter Estimation — Industry Average Parameter Estimates, 2020 Update, URL https://nrcoe.inl.gov/avgperf/ (Fails to Close (FTC))",
              "sourceRef": {
                "id": "NRC-INL-2020",
                "name": "NRC-INL 2020 Parameter Estimation",
                "description": "Industry Average Parameter Estimates, 2020 Update, URL https://nrcoe.inl.gov/avgperf/"
              },
              "effects": [
                {
                  "description": "Local: the valve does not close on demand"
                },
                {
                  "description": "System: The main steam header penetration relies on its other isolation valve"
                },
                {
                  "description": "Plant: An open path from the containment to the Reactor Building: radioactive release bypasses containment"
                },
                {
                  "description": "Detection: found on demand or at the periodic surveillance test; no alarm before the demand"
                }
              ],
              "tplFm": "FTC"
            }
          ],
          "pidSymbol": "valve-motor"
        },
