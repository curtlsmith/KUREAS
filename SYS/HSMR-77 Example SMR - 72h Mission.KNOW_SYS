      "systemLogic": [
        {
          "type": "comment",
          "value": "# Control room HVAC (CRV): habitability of the main control room for 72 hours",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "'''",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@source { HSMR-77-SDD Control room HVAC: two 100 % trains (AHU and chiller; A running, B standby), one emergency filtration",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "  unit and two outside-air isolation dampers in series. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@source { NRC-INL-2020 Fan, chiller, filter and motor-operated damper data. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@boundary { The HVAC equipment room in the Control Building, the dampers in the outside-air intake, and the power and",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "  auto-start cables. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@basis { Habitability needs one HVAC train (AHU and chiller), the filtration unit, and outside-air isolation by either damper. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@assumption key { Train B starts automatically; its start cable is driven from the plant control system cabinet in the MCR. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
