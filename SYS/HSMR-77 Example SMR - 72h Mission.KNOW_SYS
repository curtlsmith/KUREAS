      "view3d": {
        "script": "# 480 VAC Division B (with BESS backup) (EPB): 3D layout of its SSCs in the HSMR-77 buildings.\n# Parts are named with the SSC controlled names, so each part (or GROUP) links to its SSC.\n# Rooms and buildings come from the Project 3D script; cables are WIREs routed through the rooms.\n\nPART EPB_ELECT_CBK_B = BOX(W=1.0, H=2.4, L=1.4) IN EB_MV AT (8.8, 0, 0.1) COLOR 0x4b6584;\nPART EPB_ELECT_TRANS_B = BOX(W=2.0, H=2.2, L=1.6) IN EB_LVB AT (-3.5, 0, -2.5) COLOR 0x5d7a5a;\nPART EPB_ELECT_BUS_B = BOX(W=4.0, H=2.3, L=1.2) IN EB_LVB AT (0.5, 0, -3) COLOR 0x6f7a86;\nPART EPB_ELECT_MCC_B = BOX(W=3.2, H=2.3, L=0.6) IN EB_LVB AT (1, 0, 3) COLOR 0x4b6584;\nPART EPB_ELECT_ABT_B = BOX(W=0.9, H=2.0, L=0.9) IN EB_LVB AT (4.2, 0, -3) COLOR 0x3f6f8f;\nPART EPB_ELECT_BESS_B = BOX(W=7.0, H=2.6, L=2.4) IN EB_BESSB AT (-1.5, 0, 0) COLOR 0x2a8f86;\nPART EPB_ELECT_INV_B = BOX(W=1.8, H=2.2, L=1.0) IN EB_BESSB AT (4, 0, -3.5) COLOR 0x3f6f8f;\n\n# --- cables: power (red), DC (orange), MV (black) and control (purple), routed above the equipment ---\nPART EPB_CABLE_MVCBL_B_XFMR = WIRE(D=0.08) FROM (58.457, 2.45, -12.4) THROUGH (58.457, 6.42, -12.4), (53.14, 6.42, -12.4), (53.14, 6.42, -5) TO (53.14, 2.25, -5) COLOR black;\nPART EPB_CABLE_PCBL_B_BESS = WIRE(D=0.05) FROM (60.64, 2.25, 6.5) THROUGH (60.64, 6.475, 6.5), (60.891, 6.475, 6.5), (60.891, 6.475, -5.5) TO (60.891, 2.05, -5.5) COLOR red;\nALLOW EPB_CABLE_* WITH RXB, RXB_GALLERY, RXB_CVCS, CB, CB_MCR, CB_ICA, CB_ICB, CB_DCA, CB_DCB, CB_HVACA, CB_HVACB, EB, EB_MV, EB_LVA, EB_LVB, EB_BESSA, EB_BESSB, AUX, AUX_CCW, TGB, TGB_FW, UHS_STRUCT_POOL;\nALLOW EPB_CABLE_* WITH EPB_CABLE_*;\n# cables of other systems share the same overhead raceways and risers\nALLOW EPB_CABLE_* WITH OSP_CABLE_MVCBL_UAT, EPA_CABLE_MVCBL_A_XFMR, EPA_CABLE_PCBL_A_BESS, DCA_CABLE_DCBL_A_BAT, DCA_CABLE_PCBL_A_BCH, DCB_CABLE_DCBL_B_BAT, DCB_CABLE_PCBL_B_BCH, SEN_CABLE_CCBL_1, SEN_CABLE_CCBL_2, SEN_CABLE_CCBL_3, SEN_CABLE_CCBL_4, RPS_CABLE_CCBL_A_TRIP;\nALLOW EPB_CABLE_* WITH RPS_CABLE_CCBL_A_MTRIP, RPS_CABLE_DCBL_A_SHT, RPS_CABLE_CCBL_B_TRIP, RPS_CABLE_CCBL_B_MTRIP, RPS_CABLE_DCBL_B_SHT, ESA_CABLE_DCBL_A_ESF, ESB_CABLE_DCBL_B_ESF, ECCS_CABLE_CCBL_RVV1A, ECCS_CABLE_CCBL_RVV1B, ECCS_CABLE_CCBL_RVV2A, ECCS_CABLE_CCBL_RVV2B, ECCS_CABLE_CCBL_RVV3A;\nALLOW EPB_CABLE_* WITH ECCS_CABLE_CCBL_RVV3B, ECCS_CABLE_CCBL_RRV1A, ECCS_CABLE_CCBL_RRV1B, ECCS_CABLE_CCBL_RRV2A, ECCS_CABLE_CCBL_RRV2B, DHRS_CABLE_CCBL_A_AV1, DHRS_CABLE_CCBL_A_AV2, DHRS_CABLE_CCBL_A_MDHRS, DHRS_CABLE_CCBL_B_AV1, DHRS_CABLE_CCBL_B_AV2, DHRS_CABLE_CCBL_B_MDHRS, CIS_CABLE_PCBL_A_MSI;\nALLOW EPB_CABLE_* WITH CIS_CABLE_CCBL_A_MSI, CIS_CABLE_PCBL_B_MSO, CIS_CABLE_CCBL_B_MSO, CIS_CABLE_PCBL_A_FWI, CIS_CABLE_CCBL_A_FWI, CIS_CABLE_PCBL_B_FWO, CIS_CABLE_CCBL_B_FWO, CIS_CABLE_PCBL_A_INJI, CIS_CABLE_CCBL_A_INJI, CIS_CABLE_PCBL_B_INJO, CIS_CABLE_CCBL_B_INJO, CIS_CABLE_PCBL_A_LTDI;\nALLOW EPB_CABLE_* WITH CIS_CABLE_CCBL_A_LTDI, CIS_CABLE_PCBL_B_LTDO, CIS_CABLE_CCBL_B_LTDO, CVCS_CABLE_PCBL_A, CVCS_CABLE_PCBL_B, CVCS_CABLE_CCBL_B, CCW_CABLE_PCBL_A_PMP, CCW_CABLE_PCBL_B_PMP, CCW_CABLE_PCBL_A_FAN, CCW_CABLE_PCBL_B_FAN, CCW_CABLE_CCBL_B_PMP, CCW_CABLE_CCBL_B_FAN;\nALLOW EPB_CABLE_* WITH CRV_CABLE_PCBL_A_AHU, CRV_CABLE_PCBL_B_AHU, CRV_CABLE_PCBL_A_CHL, CRV_CABLE_PCBL_B_CHL, CRV_CABLE_PCBL_A_DMP, CRV_CABLE_PCBL_B_DMP, CRV_CABLE_CCBL_B_START, FWS_CABLE_PCBL_COND, FWS_CABLE_MVCBL_A_FWP, FWS_CABLE_MVCBL_B_FWP, FWS_CABLE_CCBL_B_FWP;\n"
      },
