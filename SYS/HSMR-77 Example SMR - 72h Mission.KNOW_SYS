              "effects": [
                {
                  "description": "Local: the breaker opens spuriously and stays open"
                },
                {
                  "description": "System: All Division A DC loads are lost"
                },
                {
                  "description": "Plant: Division A energize-to-actuate functions (ESFAS A, shunt trip of RTB-A, ECCS and DHRS pilot solenoids) are lost"
                },
                {
                  "description": "Detection: annunciated or found by routine monitoring; repair started at once"
                }
              ],
              "tplFm": "SPUR"
            }
          ],
          "pidSymbol": "breaker"
        }
