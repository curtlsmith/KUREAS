      "boundaryConditions": [],
      "systemLogic": [
        {
          "type": "comment",
          "value": "# Chemical and Volume Control System (CVCS): RCS makeup from the makeup tank with two pumps",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "'''",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@source { HSMR-77-SDD CVCS: one makeup tank, two 100 % makeup pumps (A running, B on standby with auto-start), a common",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "  suction and a common discharge header to the RPV injection line. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@source { NRC-INL-2020 Motor-driven pump, check valve, tank, pipe and PLC data. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@boundary { From the makeup tank to the RPV injection penetration (the CIS valves on that line are in CIS), with the pump",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "  power cables and the auto-start controller and cable. Cooling of the pumps comes from CCW. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@basis { Makeup works when the tank and both headers are intact and either pump train runs, with CCW cooling. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@assumption key { Pump B needs the auto-start signal from the plant control system; no manual start is credited. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@modeler CLS 2026-10-13 { Normal makeup function used as a front-line inventory-control system. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "'''",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "module_def",
          "value": "PWR-A",
          "deletable": true
