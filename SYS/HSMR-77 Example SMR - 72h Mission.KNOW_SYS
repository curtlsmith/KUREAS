        "script": "# Emergency Core Cooling System (ECCS): 3D layout of its SSCs in the HSMR-77 buildings.\n# Parts are named with the SSC controlled names, so each part (or GROUP) links to its SSC.\n# Rooms and buildings come from the Project 3D script; cables are WIREs routed through the rooms.\n\n# --- the module: containment vessel (the ECCS-CNV SSC is the shell and head) and the RPV inside it ---\nPART X-CNV-SKIRT = CYLINDER(D=3.0, H=0.6) IN UHS_STRUCT_POOL AT (0, 0, 0) COLOR 0x6f7a86 NOLABEL;\nPART CNV-SHELL = VESSEL(D=4.6, H=17, RATIO=0.5, T=0.1) IN UHS_STRUCT_POOL AT (0, 0.6, 0) COLOR 0x9aa7b4 OPACITY 0.45 NOLABEL;\nPART CNV-HEAD = DOME(D=4.6, RATIO=0.5, T=0.1) IN CNV-SHELL CONNECT CNV-SHELL.top COLOR 0x8794a2 OPACITY 0.45 NOLABEL;\nGROUP ECCS_VES_CNV = CNV-SHELL, CNV-HEAD;\nJOIN ECCS_VES_CNV;\nPART RPV-SHELL = VESSEL(D=2.8, H=14.2, RATIO=0.5, T=0.12) IN UHS_STRUCT_POOL AT (0, 1.6, 0) COLOR 0x5d6d7e OPACITY 0.55 LABEL \"RPV\";\nPART RPV-HEAD = DOME(D=2.8, RATIO=0.5, T=0.12) IN RPV-SHELL CONNECT RPV-SHELL.top COLOR 0x5d6d7e OPACITY 0.55 NOLABEL;\nJOIN RPV-SHELL, RPV-HEAD;\nALLOW RPV-SHELL, RPV-HEAD WITH CNV-SHELL, CNV-HEAD, X-CNV-SKIRT;\nALLOW CNV-SHELL WITH X-CNV-SKIRT;\nPART ECCS_VALVE_HOV_RVV1 = VALVE(D=0.26) IN UHS_STRUCT_POOL AT (0, 14.6, 1.82) DIR +Y COLOR 0x3f6f8f;\nPART ECCS_VALVE_HOV_RVV2 = VALVE(D=0.26) IN UHS_STRUCT_POOL AT (-1.576, 14.6, -0.91) DIR +Y COLOR 0x3f6f8f;\nPART ECCS_VALVE_HOV_RVV3 = VALVE(D=0.26) IN UHS_STRUCT_POOL AT (1.576, 14.6, -0.91) DIR +Y COLOR 0x3f6f8f;\nPART ECCS_VALVE_HOV_RRV1 = VALVE(D=0.26) IN UHS_STRUCT_POOL AT (1.576, 5.5, 0.91) DIR +Y COLOR 0x3f6f8f;\nPART ECCS_VALVE_HOV_RRV2 = VALVE(D=0.26) IN UHS_STRUCT_POOL AT (-1.576, 5.5, 0.91) DIR +Y COLOR 0x3f6f8f;\nPART ECCS_VALVE_SOV_RVV1A = CYLINDER(D=0.14, H=0.32) IN UHS_STRUCT_POOL AT (-0.606, 14.9, 1.958) COLOR yellow;\nPART ECCS_VALVE_SOV_RVV1B = CYLINDER(D=0.14, H=0.32) IN UHS_STRUCT_POOL AT (0.606, 14.9, 1.958) COLOR gold;\nPART ECCS_VALVE_SOV_RVV2A = CYLINDER(D=0.14, H=0.32) IN UHS_STRUCT_POOL AT (-1.393, 14.9, -1.504) COLOR yellow;\nPART ECCS_VALVE_SOV_RVV2B = CYLINDER(D=0.14, H=0.32) IN UHS_STRUCT_POOL AT (-1.999, 14.9, -0.455) COLOR gold;\nPART ECCS_VALVE_SOV_RVV3A = CYLINDER(D=0.14, H=0.32) IN UHS_STRUCT_POOL AT (1.999, 14.9, -0.455) COLOR yellow;\nPART ECCS_VALVE_SOV_RVV3B = CYLINDER(D=0.14, H=0.32) IN UHS_STRUCT_POOL AT (1.393, 14.9, -1.504) COLOR gold;\nPART ECCS_VALVE_SOV_RRV1A = CYLINDER(D=0.14, H=0.32) IN UHS_STRUCT_POOL AT (1.393, 5.8, 1.504) COLOR yellow;\nPART ECCS_VALVE_SOV_RRV1B = CYLINDER(D=0.14, H=0.32) IN UHS_STRUCT_POOL AT (1.999, 5.8, 0.455) COLOR gold;\nPART ECCS_VALVE_SOV_RRV2A = CYLINDER(D=0.14, H=0.32) IN UHS_STRUCT_POOL AT (-1.999, 5.8, 0.455) COLOR yellow;\nPART ECCS_VALVE_SOV_RRV2B = CYLINDER(D=0.14, H=0.32) IN UHS_STRUCT_POOL AT (-1.393, 5.8, 1.504) COLOR gold;\nALLOW ECCS_VALVE_* WITH CNV-SHELL, CNV-HEAD, RPV-SHELL, RPV-HEAD;\n\n# --- cables: power (red), DC (orange), MV (black) and control (purple), routed above the equipment ---\nPART ECCS_CABLE_CCBL_RVV1A = WIRE(D=0.025) FROM (2.326, 2.05, 25.2) THROUGH (2.326, 7.41, 25.2), (2.326, 7.41, 18.5), (2.326, 21.92, 18.5), (-9.64, 21.92, 18.5), (-9.64, 21.92, 1.958) TO (-9.64, 15.27, 1.958) COLOR purple;\nPART ECCS_CABLE_CCBL_RVV1B = WIRE(D=0.025) FROM (2.326, 2.05, 35.2) THROUGH (2.326, 7.465, 35.2), (2.326, 7.465, 18.55), (2.326, 21.98, 18.55), (-8.428, 21.98, 18.55), (-8.428, 21.98, 1.958) TO (-8.428, 15.27, 1.958) COLOR purple;\nPART ECCS_CABLE_CCBL_RVV2A = WIRE(D=0.025) FROM (2.417, 2.05, 25.2) THROUGH (2.417, 7.52, 25.2), (2.417, 7.52, 18.6), (2.417, 22.04, 18.6), (-10.427, 22.04, 18.6), (-10.427, 22.04, -1.504) TO (-10.427, 15.27, -1.504) COLOR purple;\nPART ECCS_CABLE_CCBL_RVV2B = WIRE(D=0.025) FROM (2.417, 2.05, 35.2) THROUGH (2.417, 7.575, 35.2), (2.417, 7.575, 18.65), (2.417, 22.1, 18.65), (-11.033, 22.1, 18.65), (-11.033, 22.1, -0.455) TO (-11.033, 15.27, -0.455) COLOR purple;\nPART ECCS_CABLE_CCBL_RVV3A = WIRE(D=0.025) FROM (2.509, 2.05, 25.2) THROUGH (2.509, 7.63, 25.2), (2.509, 7.63, 18.7), (2.509, 22.16, 18.7), (-7.035, 22.16, 18.7), (-7.035, 22.16, -0.455) TO (-7.035, 15.27, -0.455) COLOR purple;\nPART ECCS_CABLE_CCBL_RVV3B = WIRE(D=0.025) FROM (2.509, 2.05, 35.2) THROUGH (2.509, 7.685, 35.2), (2.509, 7.685, 18.75), (2.509, 22.22, 18.75), (-7.641, 22.22, 18.75), (-7.641, 22.22, -1.504) TO (-7.641, 15.27, -1.504) COLOR purple;\nPART ECCS_CABLE_CCBL_RRV1A = WIRE(D=0.025) FROM (2.6, 2.05, 25.2) THROUGH (2.6, 7.74, 25.2), (2.6, 7.74, 18.8), (2.6, 22.28, 18.8), (-7.641, 22.28, 18.8), (-7.641, 22.28, 1.504) TO (-7.641, 6.17, 1.504) COLOR purple;\nPART ECCS_CABLE_CCBL_RRV1B = WIRE(D=0.025) FROM (2.6, 2.05, 35.2) THROUGH (2.6, 7.795, 35.2), (2.6, 7.795, 18.85), (2.6, 22.34, 18.85), (-7.035, 22.34, 18.85), (-7.035, 22.34, 0.455) TO (-7.035, 6.17, 0.455) COLOR purple;\nPART ECCS_CABLE_CCBL_RRV2A = WIRE(D=0.025) FROM (2.691, 2.05, 25.2) THROUGH (2.691, 7.85, 25.2), (2.691, 7.85, 18.9), (2.691, 22.4, 18.9), (-11.033, 22.4, 18.9), (-11.033, 22.4, 0.455) TO (-11.033, 6.17, 0.455) COLOR purple;\nPART ECCS_CABLE_CCBL_RRV2B = WIRE(D=0.025) FROM (2.691, 2.05, 35.2) THROUGH (2.691, 7.905, 35.2), (2.691, 7.905, 18.95), (2.691, 22.46, 18.95), (-10.427, 22.46, 18.95), (-10.427, 22.46, 1.504) TO (-10.427, 6.17, 1.504) COLOR purple;\nALLOW ECCS_CABLE_* WITH RXB, RXB_GALLERY, RXB_CVCS, CB, CB_MCR, CB_ICA, CB_ICB, CB_DCA, CB_DCB, CB_HVACA, CB_HVACB, EB, EB_MV, EB_LVA, EB_LVB, EB_BESSA, EB_BESSB, AUX, AUX_CCW, TGB, TGB_FW, UHS_STRUCT_POOL;\nALLOW ECCS_CABLE_* WITH ECCS_CABLE_*;\nALLOW ECCS_CABLE_* WITH CNV-SHELL, CNV-HEAD, RPV-SHELL, RPV-HEAD;\n# cables of other systems share the same overhead raceways and risers\nALLOW ECCS_CABLE_* WITH OSP_CABLE_MVCBL_UAT, EPA_CABLE_MVCBL_A_XFMR, EPA_CABLE_PCBL_A_BESS, EPB_CABLE_MVCBL_B_XFMR, EPB_CABLE_PCBL_B_BESS, DCA_CABLE_DCBL_A_BAT, DCA_CABLE_PCBL_A_BCH, DCB_CABLE_DCBL_B_BAT, DCB_CABLE_PCBL_B_BCH, SEN_CABLE_CCBL_1, SEN_CABLE_CCBL_2, SEN_CABLE_CCBL_3;\nALLOW ECCS_CABLE_* WITH SEN_CABLE_CCBL_4, RPS_CABLE_CCBL_A_TRIP, RPS_CABLE_CCBL_A_MTRIP, RPS_CABLE_DCBL_A_SHT, RPS_CABLE_CCBL_B_TRIP, RPS_CABLE_CCBL_B_MTRIP, RPS_CABLE_DCBL_B_SHT, ESA_CABLE_DCBL_A_ESF, ESB_CABLE_DCBL_B_ESF, DHRS_CABLE_CCBL_A_AV1, DHRS_CABLE_CCBL_A_AV2, DHRS_CABLE_CCBL_A_MDHRS;\nALLOW ECCS_CABLE_* WITH DHRS_CABLE_CCBL_B_AV1, DHRS_CABLE_CCBL_B_AV2, DHRS_CABLE_CCBL_B_MDHRS, CIS_CABLE_PCBL_A_MSI, CIS_CABLE_CCBL_A_MSI, CIS_CABLE_PCBL_B_MSO, CIS_CABLE_CCBL_B_MSO, CIS_CABLE_PCBL_A_FWI, CIS_CABLE_CCBL_A_FWI, CIS_CABLE_PCBL_B_FWO, CIS_CABLE_CCBL_B_FWO, CIS_CABLE_PCBL_A_INJI;\nALLOW ECCS_CABLE_* WITH CIS_CABLE_CCBL_A_INJI, CIS_CABLE_PCBL_B_INJO, CIS_CABLE_CCBL_B_INJO, CIS_CABLE_PCBL_A_LTDI, CIS_CABLE_CCBL_A_LTDI, CIS_CABLE_PCBL_B_LTDO, CIS_CABLE_CCBL_B_LTDO, CVCS_CABLE_PCBL_A, CVCS_CABLE_PCBL_B, CVCS_CABLE_CCBL_B, CCW_CABLE_PCBL_A_PMP, CCW_CABLE_PCBL_B_PMP;\nALLOW ECCS_CABLE_* WITH CCW_CABLE_PCBL_A_FAN, CCW_CABLE_PCBL_B_FAN, CCW_CABLE_CCBL_B_PMP, CCW_CABLE_CCBL_B_FAN, CRV_CABLE_PCBL_A_AHU, CRV_CABLE_PCBL_B_AHU, CRV_CABLE_PCBL_A_CHL, CRV_CABLE_PCBL_B_CHL, CRV_CABLE_PCBL_A_DMP, CRV_CABLE_PCBL_B_DMP, CRV_CABLE_CCBL_B_START, FWS_CABLE_PCBL_COND;\nALLOW ECCS_CABLE_* WITH FWS_CABLE_MVCBL_A_FWP, FWS_CABLE_MVCBL_B_FWP, FWS_CABLE_CCBL_B_FWP;\n"
      },
