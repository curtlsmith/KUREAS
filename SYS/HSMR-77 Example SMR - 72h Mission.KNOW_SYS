        {
          "type": "comment",
          "value": "# Component Cooling Water (CCW): closed cooling loop for the CVCS pumps, rejecting heat to a two-cell cooling tower",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
