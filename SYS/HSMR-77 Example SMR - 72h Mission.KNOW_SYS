  "reportElements": [],
  "projectImages": [],
  "projectView3d": "# HSMR-77 hypothetical small modular reactor: site, buildings and rooms (the Project 3D script).\n# Every system's 3D script inherits UNITS and the variables below. Rooms are fire areas for the\n# location-based fire model: an SSC's room is the ROOM it is placed IN.\n# Buildings: RXB Reactor Building (pool, piping gallery, CVCS room), CB Control Building (MCR, Division A/B I&C\n# and 125 VDC rooms, HVAC room), EB Electrical Building (13.8 kV room, Division A/B 480 V and BESS rooms),\n# AUX Auxiliary Building (CCW), TGB Turbine Generator Building (feedwater). The switchyard and the cooling\n# tower are outdoors. The reactor pool is the UHS SSC and is defined in the UHS script.\n\nUNITS SI;\nOUTPUT SI;\nFOOTPRINT X 175 Y 112 AT (6, 0, -4) LAT 43.52000 LON -112.05000 NORTH 0 ELEV 1490 BORDER 14 NAME \"HSMR-77 (hypothetical site)\";\nVIEW AZIMUTH 205 ELEVATION 38 AT (4, 4, -2) DISTANCE 175;\nLABELS SIZE 1.0 BACKOPACITY 0.6;\nWALLS = 0.18;\nINNER = 0.28;\n\nROOM RXB (W=44, L=32, H=24, T=1.0) AT (0, 0, 0) OPACITY WALLS LABEL \"Reactor Building\";\nROOM RXB_GALLERY (W=11, L=12, H=8, T=0.4) IN RXB AT (13.5, 0, -8) OPACITY INNER LABEL \"RXB piping and valve gallery\";\nROOM RXB_CVCS (W=11, L=12, H=6, T=0.4) IN RXB AT (13.5, 0, 8) OPACITY INNER LABEL \"RXB CVCS equipment room\";\nROOM CB (W=44, L=20, H=9, T=0.8) AT (0, 0, 30) OPACITY WALLS LABEL \"Control Building\";\nROOM CB_MCR (W=16, L=14, H=5, T=0.3) IN CB AT (-12, 0, 0) OPACITY INNER LABEL \"Main control room\";\nROOM CB_ICA (W=7, L=8, H=5, T=0.3) IN CB AT (1, 0, -5) OPACITY INNER LABEL \"Division A I&C equipment room\";\nROOM CB_ICB (W=7, L=8, H=5, T=0.3) IN CB AT (1, 0, 5) OPACITY INNER LABEL \"Division B I&C equipment room\";\nROOM CB_DCA (W=7, L=8, H=5, T=0.3) IN CB AT (10, 0, -5) OPACITY INNER LABEL \"Division A 125 VDC room\";\nROOM CB_DCB (W=7, L=8, H=5, T=0.3) IN CB AT (10, 0, 5) OPACITY INNER LABEL \"Division B 125 VDC room\";\nROOM CB_HVACA (W=5, L=9, H=5, T=0.3) IN CB AT (18.5, 0, -5) OPACITY INNER LABEL \"Control room HVAC train A room\";\nROOM CB_HVACB (W=5, L=9, H=5, T=0.3) IN CB AT (18.5, 0, 5) OPACITY INNER LABEL \"Control room HVAC train B room\";\nROOM EB (W=30, L=34, H=9, T=0.8) AT (50, 0, 0) OPACITY WALLS LABEL \"Electrical Building\";\nROOM EB_MV (W=26, L=7, H=6, T=0.3) IN EB AT (0, 0, -12.5) OPACITY INNER LABEL \"13.8 kV switchgear room\";\nROOM EB_LVA (W=12, L=10, H=6, T=0.3) IN EB AT (-7, 0, -2.5) OPACITY INNER LABEL \"Division A 480 V switchgear room\";\nROOM EB_LVB (W=12, L=10, H=6, T=0.3) IN EB AT (7, 0, -2.5) OPACITY INNER LABEL \"Division B 480 V switchgear room\";\nROOM EB_BESSA (W=12, L=11, H=6, T=0.4) IN EB AT (-7, 0, 10) OPACITY INNER LABEL \"Division A BESS room\";\nROOM EB_BESSB (W=12, L=11, H=6, T=0.4) IN EB AT (7, 0, 10) OPACITY INNER LABEL \"Division B BESS room\";\nROOM AUX (W=26, L=16, H=8, T=0.8) AT (50, 0, 34) OPACITY WALLS LABEL \"Auxiliary Building\";\nROOM AUX_CCW (W=24, L=14, H=6, T=0.3) IN AUX AT (0, 0, 0) OPACITY INNER LABEL \"CCW pump and heat exchanger room\";\nROOM TGB (W=36, L=34, H=16, T=0.8) AT (-52, 0, 0) OPACITY WALLS LABEL \"Turbine Generator Building\";\nROOM TGB_FW (W=18, L=12, H=6, T=0.3) IN TGB AT (-5, 0, -9) OPACITY INNER LABEL \"Feedwater pump room\";\n\n# --- context (not SSCs): turbine-generator, main condenser, switchyard fence and pad, MCR consoles ---\nPART X-TG = CYLINDER(D=3.0, H=14) IN TGB AT (-8, 1.6, 9) DIR +X COLOR steel LABEL \"Turbine-generator\";\nPART X-COND = BOX(W=10, H=5, L=6) IN TGB AT (0, 0, 9) COLOR 0x8d99a6 LABEL \"Main condenser\";\nALLOW X-TG WITH X-COND;\nPART X-YARD = BOX(W=24, H=0.2, L=16) AT (38, 0, -37) COLOR concrete LABEL \"Switchyard\";\nPART X-CONSOLE = BOX(W=7, H=0.9, L=1.2) IN CB_MCR AT (0, 0, -4.2) COLOR 0x33373c LABEL \"Main control board\";\nPART X-SRO = BOX(W=2.0, H=0.75, L=1.0) IN CB_MCR AT (0, 0, 1.0) COLOR 0x33373c LABEL \"Shift supervisor desk\";\n\nTEXT \"Reactor Building\" AT RXB OFFSET (0, 25.5, 0) SIZE 2.2;\nTEXT \"Control Building\" AT CB OFFSET (0, 10, 0) SIZE 1.8;\nTEXT \"Electrical Building\" AT EB OFFSET (0, 10, 0) SIZE 1.8;\nTEXT \"Auxiliary Building (CCW)\" AT AUX OFFSET (0, 9, 0) SIZE 1.6;\nTEXT \"Turbine Generator Building\" AT TGB OFFSET (0, 17, 0) SIZE 1.8;\nTEXT \"Switchyard\" AT X-YARD OFFSET (0, 6, 0) SIZE 1.6;\n",
  "sscTemplates": [
