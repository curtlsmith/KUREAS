      "view3d": {
        "script": "# Control Room HVAC (habitability) (CRV): 3D layout of its SSCs in the HSMR-77 buildings.\n# Parts are named with the SSC controlled names, so each part (or GROUP) links to its SSC.\n# Rooms and buildings come from the Project 3D script; cables are WIREs routed through the rooms.\n\nPART CRV_HVAC_FAN_A = BOX(W=2.4, H=2.2, L=3.2) IN CB_HVACA AT (0, 0, -2.6) COLOR silver;\nPART CRV_HVAC_FAN_B = BOX(W=2.4, H=2.2, L=3.2) IN CB_HVACB AT (0, 0, 2.6) COLOR silver;\nPART CRV_HVAC_CHL_A = BOX(W=2.4, H=1.8, L=2.0) IN CB_HVACA AT (0, 0, 0.4) COLOR 0x8d99a6;\nPART CRV_HVAC_CHL_B = BOX(W=2.4, H=1.8, L=2.0) IN CB_HVACB AT (0, 0, -0.4) COLOR 0x8d99a6;\nPART CRV_FILT_FILT = BOX(W=2.4, H=1.9, L=1.8) IN CB_HVACA AT (0, 0, 3) COLOR 0x6f7a86;\nPART CRV_HVAC_MODMP_A = BOX(W=0.4, H=1.0, L=1.0) IN CB_HVACA AT (1.8, 3, -3) COLOR 0xe07b00;\nPART CRV_HVAC_MODMP_B = BOX(W=0.4, H=1.0, L=1.0) IN CB_HVACB AT (1.8, 3, 3) COLOR 0xe07b00;\nPART CRV_PLC_FLOW_HVAC = BOX(W=0.8, H=2.0, L=0.6) IN CB_MCR AT (3.5, 0, 5.8) COLOR 0x3f6f8f;\n\n# --- cables: power (red), DC (orange), MV (black) and control (purple), routed above the equipment ---\nPART CRV_CABLE_PCBL_A_AHU = WIRE(D=0.05) FROM (43.76, 2.35, 0.6) THROUGH (43.76, 7.465, 0.6), (18.14, 7.465, 0.6), (18.14, 7.465, 22.4) TO (18.14, 2.25, 22.4) COLOR red;\nPART CRV_CABLE_PCBL_B_AHU = WIRE(D=0.05) FROM (57.76, 2.35, 0.6) THROUGH (57.76, 7.52, 0.6), (18.14, 7.52, 0.6), (18.14, 7.52, 37.6) TO (18.14, 2.25, 37.6) COLOR red;\nPART CRV_CABLE_PCBL_A_CHL = WIRE(D=0.05) FROM (43.88, 2.35, 0.6) THROUGH (43.88, 7.575, 0.6), (18.14, 7.575, 0.6), (18.14, 7.575, 25.4) TO (18.14, 1.85, 25.4) COLOR red;\nPART CRV_CABLE_PCBL_B_CHL = WIRE(D=0.05) FROM (57.88, 2.35, 0.6) THROUGH (57.88, 7.63, 0.6), (18.14, 7.63, 0.6), (18.14, 7.63, 34.6) TO (18.14, 1.85, 34.6) COLOR red;\nPART CRV_CABLE_PCBL_A_DMP = WIRE(D=0.05) FROM (44, 2.35, 0.6) THROUGH (44, 7.685, 0.6), (20.163, 7.685, 0.6), (20.163, 7.685, 22) TO (20.163, 4.05, 22) COLOR red;\nPART CRV_CABLE_PCBL_B_DMP = WIRE(D=0.05) FROM (58, 2.35, 0.6) THROUGH (58, 7.74, 0.6), (20.163, 7.74, 0.6), (20.163, 7.74, 38) TO (20.163, 4.05, 38) COLOR red;\nPART CRV_CABLE_CCBL_B_START = WIRE(D=0.025) FROM (-8.774, 2.05, 35.8) THROUGH (-8.774, 7.795, 35.8), (18.26, 7.795, 35.8), (18.26, 7.795, 37.6) TO (18.26, 2.25, 37.6) COLOR purple;\nALLOW CRV_CABLE_* WITH RXB, RXB_GALLERY, RXB_CVCS, CB, CB_MCR, CB_ICA, CB_ICB, CB_DCA, CB_DCB, CB_HVACA, CB_HVACB, EB, EB_MV, EB_LVA, EB_LVB, EB_BESSA, EB_BESSB, AUX, AUX_CCW, TGB, TGB_FW, UHS_STRUCT_POOL;\nALLOW CRV_CABLE_* WITH CRV_CABLE_*;\n# cables of other systems share the same overhead raceways and risers\nALLOW CRV_CABLE_* WITH OSP_CABLE_MVCBL_UAT, EPA_CABLE_MVCBL_A_XFMR, EPA_CABLE_PCBL_A_BESS, EPB_CABLE_MVCBL_B_XFMR, EPB_CABLE_PCBL_B_BESS, DCA_CABLE_DCBL_A_BAT, DCA_CABLE_PCBL_A_BCH, DCB_CABLE_DCBL_B_BAT, DCB_CABLE_PCBL_B_BCH, SEN_CABLE_CCBL_1, SEN_CABLE_CCBL_2, SEN_CABLE_CCBL_3;\nALLOW CRV_CABLE_* WITH SEN_CABLE_CCBL_4, RPS_CABLE_CCBL_A_TRIP, RPS_CABLE_CCBL_A_MTRIP, RPS_CABLE_DCBL_A_SHT, RPS_CABLE_CCBL_B_TRIP, RPS_CABLE_CCBL_B_MTRIP, RPS_CABLE_DCBL_B_SHT, ESA_CABLE_DCBL_A_ESF, ESB_CABLE_DCBL_B_ESF, ECCS_CABLE_CCBL_RVV1A, ECCS_CABLE_CCBL_RVV1B, ECCS_CABLE_CCBL_RVV2A;\nALLOW CRV_CABLE_* WITH ECCS_CABLE_CCBL_RVV2B, ECCS_CABLE_CCBL_RVV3A, ECCS_CABLE_CCBL_RVV3B, ECCS_CABLE_CCBL_RRV1A, ECCS_CABLE_CCBL_RRV1B, ECCS_CABLE_CCBL_RRV2A, ECCS_CABLE_CCBL_RRV2B, DHRS_CABLE_CCBL_A_AV1, DHRS_CABLE_CCBL_A_AV2, DHRS_CABLE_CCBL_A_MDHRS, DHRS_CABLE_CCBL_B_AV1, DHRS_CABLE_CCBL_B_AV2;\nALLOW CRV_CABLE_* WITH DHRS_CABLE_CCBL_B_MDHRS, CIS_CABLE_PCBL_A_MSI, CIS_CABLE_CCBL_A_MSI, CIS_CABLE_PCBL_B_MSO, CIS_CABLE_CCBL_B_MSO, CIS_CABLE_PCBL_A_FWI, CIS_CABLE_CCBL_A_FWI, CIS_CABLE_PCBL_B_FWO, CIS_CABLE_CCBL_B_FWO, CIS_CABLE_PCBL_A_INJI, CIS_CABLE_CCBL_A_INJI, CIS_CABLE_PCBL_B_INJO;\nALLOW CRV_CABLE_* WITH CIS_CABLE_CCBL_B_INJO, CIS_CABLE_PCBL_A_LTDI, CIS_CABLE_CCBL_A_LTDI, CIS_CABLE_PCBL_B_LTDO, CIS_CABLE_CCBL_B_LTDO, CVCS_CABLE_PCBL_A, CVCS_CABLE_PCBL_B, CVCS_CABLE_CCBL_B, CCW_CABLE_PCBL_A_PMP, CCW_CABLE_PCBL_B_PMP, CCW_CABLE_PCBL_A_FAN, CCW_CABLE_PCBL_B_FAN;\nALLOW CRV_CABLE_* WITH CCW_CABLE_CCBL_B_PMP, CCW_CABLE_CCBL_B_FAN, FWS_CABLE_PCBL_COND, FWS_CABLE_MVCBL_A_FWP, FWS_CABLE_MVCBL_B_FWP, FWS_CABLE_CCBL_B_FWP;\n"
      },
