      "pidDiagram": {
        "nodes": [],
        "edges": [],
        "groups": [],
        "settings": {}
      },
      "view3d": {
        "script": "# Ultimate Heat Sink (Reactor Pool) (UHS): 3D layout of its SSCs in the HSMR-77 buildings.\n# Parts are named with the SSC controlled names, so each part (or GROUP) links to its SSC.\n# Rooms and buildings come from the Project 3D script; cables are WIREs routed through the rooms.\n\n# --- the reactor pool: a ROOM named like the UHS SSC, so other systems place parts IN it ---\nROOM UHS_STRUCT_POOL (W=22, L=28, H=20, T=1.5) IN RXB AT (-9, 0, 0) OPACITY 0.35 COLOR 0x9fb7c9 LABEL \"Reactor pool (UHS)\";\n# Liner leakage (illustrative, HSMR-ILLUS): a leak rate per part for the whole pool.\nLEAKRATE LR-POOL ON UHS_STRUCT_POOL RATE 1.0E-8 PER HOUR PER PART EF 10 MISSION 72 HOURS FLUID WATER IGNITES NO;\n"
      },
      "failureLogicTree": {
        "id": "top",
        "label": "Ultimate_Heat_Sink_(Reactor_Pool)_Fails",
