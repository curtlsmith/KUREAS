      "boundaryConditions": [],
      "systemLogic": [
        {
          "type": "comment",
          "value": "# Containment Isolation System (CIS): two motor-operated isolation valves on each of four penetrations",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "'''",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@source { HSMR-77-SDD Containment isolation: each process line through the containment vessel has an inboard (Division A)",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "  and an outboard (Division B) motor-operated isolation valve, closed by an ESFAS signal. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@source { NRC-INL-2020 Motor-operated valve fails-to-close data. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@boundary { Eight isolation valves on the main steam, feedwater, CVCS injection and CVCS letdown penetrations, with",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "  their power cables (from the Division MCCs) and actuation cables (from the ESFAS relay panels). }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@basis { Containment is isolated when every penetration is closed by at least one of its two valves. }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@conservatism { The isolation valves are taken to need motive power and the ESFAS signal to close (no fail-closed credit). }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@exclusion { Closed-system penetrations and normally closed manual valves are excluded (no active function). }",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "@modeler CLS 2026-10-13 { Four penetrations, two valves each. }",
          "deletable": true
        },
        {
