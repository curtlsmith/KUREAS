                "distribution_type": "Gamma",
                "distribution_shape_parameter": "0.3",
                "distribution_scale_parameter": "3.60E+07"
              },
              "source": "NRC-INL 2020 Parameter Estimation — Industry Average Parameter Estimates, 2020 Update, URL https://nrcoe.inl.gov/avgperf/ (External Rupture (EXRUPT))",
              "sourceRef": {
                "id": "NRC-INL-2020",
