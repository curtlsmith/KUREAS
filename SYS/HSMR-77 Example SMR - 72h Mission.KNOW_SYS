      "systemLogic": [
        {
          "type": "comment",
          "value": "# Decay Heat Removal System (DHRS): two passive natural-circulation trains to the reactor pool",
          "deletable": true
        },
        {
          "type": "eol",
          "value": ";",
          "deletable": true
        },
        {
          "type": "comment",
          "value": "'''",
