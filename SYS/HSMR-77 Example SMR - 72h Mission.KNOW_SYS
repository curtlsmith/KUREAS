    {
      "id": "sys_hsmr_fws",
      "name": "Main Feedwater (normal heat removal)",
      "acronym": "FWS",
      "description": "<h3>Function</h3><p>Main feedwater (FWS) supplies the steam generators for normal heat removal and is the first means of decay heat removal after a trip.</p>\n<h3>Configuration</h3><p>Condenser hotwell, one condensate pump (Division A 480 V), two 100 % feedwater pumps (A running, B standby; both on the 13.8 kV bus\nthrough MV cables), the regulating valve, the feedwater controller (in the main control room) and the feedwater header to the Reactor Building.</p>\n<h3>Success criterion</h3><p>Condensate train AND (pump A OR pump B, the standby pump needing its auto-start controller and cable) AND regulating valve AND header AND offsite power.</p>\n<h3>Fire</h3><p>The feedwater pumps use NUREG-2169 bin 32 (main feedwater pumps) with a count of 2.</p>",
      "sscsInSystem": [
        {
          "id": 1790000000517,
          "name": "FWS_TANK_TANK_HW",
          "savedId": "FWS-HW",
          "description": "Main condenser hotwell (condensate storage for the feedwater pumps)",
          "label": "Tank (TANK)",
          "sscType": "Tank (TANK)",
          "system": "Main Feedwater (normal heat removal)",
          "uniqueLabel": "HW",
          "trainId": "",
          "moduleId": "",
          "templateId": "tpl_hsmr_tank",
          "source": {
            "id": "NRC-INL-2020",
            "name": "NRC-INL 2020 Parameter Estimation",
            "description": "Industry Average Parameter Estimates, 2020 Update, URL https://nrcoe.inl.gov/avgperf/"
          },
          "failureModes": [
            {
              "id": 1790000000015,
              "mode": "EXRUPT",
              "probabilityType": "probability",
              "applicable": true,
              "lambda": "8.30E-09",
              "failureModel": "2",
              "missionTime": "72",
              "data": {
                "system": "",
                "ssc_type": "Tank (TANK)",
                "component_type": "Tank (TANK)",
                "failure_mode": "External Rupture (EXRUPT)",
                "description": "Tank (TANK) External Rupture (EXRUPT).",
                "units": "h",
