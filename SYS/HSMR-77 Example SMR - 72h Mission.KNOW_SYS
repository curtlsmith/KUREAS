      "view3d": {
        "script": "# Decay Heat Removal System (DHRS): 3D layout of its SSCs in the HSMR-77 buildings.\n# Parts are named with the SSC controlled names, so each part (or GROUP) links to its SSC.\n# Rooms and buildings come from the Project 3D script; cables are WIREs routed through the rooms.\n\nPART DHRS_SWC_MAN_A_DHRS = BOX(W=0.3, H=0.25, L=0.2) IN CB_MCR AT (-2, 0.9, -3.8) COLOR green;\nPART DHRS_SWC_MAN_B_DHRS = BOX(W=0.3, H=0.25, L=0.2) IN CB_MCR AT (2, 0.9, -3.8) COLOR green;\nPART DHRS_VALVE_HOV_A_AV1 = VALVE(D=0.2) IN UHS_STRUCT_POOL AT (-3.55, 7.6, 0.8) COLOR 0x3f6f8f;\nPART DHRS_VALVE_HOV_A_AV2 = VALVE(D=0.2) IN UHS_STRUCT_POOL AT (-3.55, 7.6, 1.9) COLOR 0x3f6f8f;\nPART DHRS_VALVE_SOV_A_AV1 = CYLINDER(D=0.12, H=0.3) IN UHS_STRUCT_POOL AT (-3.25, 8.45, 1.15) COLOR yellow;\nPART DHRS_VALVE_SOV_A_AV2 = CYLINDER(D=0.12, H=0.3) IN UHS_STRUCT_POOL AT (-3.25, 8.45, 2.25) COLOR yellow;\nPART DHRS_HTX_HTX_A = BOX(W=0.9, H=4.0, L=2.6) IN UHS_STRUCT_POOL AT (-4.8, 8.4, 0) COLOR 0x8d99a6;\nPART DHRS_VALVE_HOV_B_AV1 = VALVE(D=0.2) IN UHS_STRUCT_POOL AT (2.95, 7.6, 0.8) COLOR 0x3f6f8f;\nPART DHRS_VALVE_HOV_B_AV2 = VALVE(D=0.2) IN UHS_STRUCT_POOL AT (2.95, 7.6, 1.9) COLOR 0x3f6f8f;\nPART DHRS_VALVE_SOV_B_AV1 = CYLINDER(D=0.12, H=0.3) IN UHS_STRUCT_POOL AT (3.25, 8.45, 1.15) COLOR gold;\nPART DHRS_VALVE_SOV_B_AV2 = CYLINDER(D=0.12, H=0.3) IN UHS_STRUCT_POOL AT (3.25, 8.45, 2.25) COLOR gold;\nPART DHRS_HTX_HTX_B = BOX(W=0.9, H=4.0, L=2.6) IN UHS_STRUCT_POOL AT (4.8, 8.4, 0) COLOR 0x8d99a6;\n# --- DHRS train A steam line, steam generator outlet to the passive condenser ---\nPART DHRS_PIPE_NPIPE_A_STM-S1 = PIPE(D=0.2, L=2.45) AT (-11.35, 15, -0.6) DIR -X COLOR steel NOLABEL;\nPART DHRS_PIPE_NPIPE_A_STM-S2 = PIPE(D=0.2, L=2.55) AT (-13.8, 15, -0.6) DIR -Y COLOR steel NOLABEL;\nGROUP DHRS_PIPE_NPIPE_A_STM = DHRS_PIPE_NPIPE_A_STM-S1, DHRS_PIPE_NPIPE_A_STM-S2;\nJOIN DHRS_PIPE_NPIPE_A_STM;\n# --- DHRS train A condensate line, condenser back to the steam generator feed inlet ---\nPART DHRS_PIPE_NPIPE_A_CND-S1 = PIPE(D=0.15, L=0.75) AT (-13.8, 8.35, 0.8) DIR -Y COLOR steel NOLABEL;\nPART DHRS_PIPE_NPIPE_A_CND-S2 = PIPE(D=0.15, L=2.4) AT (-13.8, 7.6, 0.8) DIR +X COLOR steel NOLABEL;\nGROUP DHRS_PIPE_NPIPE_A_CND = DHRS_PIPE_NPIPE_A_CND-S1, DHRS_PIPE_NPIPE_A_CND-S2;\nJOIN DHRS_PIPE_NPIPE_A_CND;\n# --- DHRS train B steam line, steam generator outlet to the passive condenser ---\nPART DHRS_PIPE_NPIPE_B_STM-S1 = PIPE(D=0.2, L=2.45) AT (-6.65, 15, -0.6) DIR +X COLOR steel NOLABEL;\nPART DHRS_PIPE_NPIPE_B_STM-S2 = PIPE(D=0.2, L=2.55) AT (-4.2, 15, -0.6) DIR -Y COLOR steel NOLABEL;\nGROUP DHRS_PIPE_NPIPE_B_STM = DHRS_PIPE_NPIPE_B_STM-S1, DHRS_PIPE_NPIPE_B_STM-S2;\nJOIN DHRS_PIPE_NPIPE_B_STM;\n# --- DHRS train B condensate line, condenser back to the steam generator feed inlet ---\nPART DHRS_PIPE_NPIPE_B_CND-S1 = PIPE(D=0.15, L=0.75) AT (-4.2, 8.35, 0.8) DIR -Y COLOR steel NOLABEL;\nPART DHRS_PIPE_NPIPE_B_CND-S2 = PIPE(D=0.15, L=2.4) AT (-4.2, 7.6, 0.8) DIR -X COLOR steel NOLABEL;\nGROUP DHRS_PIPE_NPIPE_B_CND = DHRS_PIPE_NPIPE_B_CND-S1, DHRS_PIPE_NPIPE_B_CND-S2;\nJOIN DHRS_PIPE_NPIPE_B_CND;\n\n# --- cables: power (red), DC (orange), MV (black) and control (purple), routed above the equipment ---\nPART DHRS_CABLE_CCBL_A_AV1 = WIRE(D=0.025) FROM (2.783, 2.05, 25.2) THROUGH (2.783, 7.96, 25.2), (2.783, 7.96, 18.2), (2.783, 22.52, 18.2), (-12.276, 22.52, 18.2), (-12.276, 22.52, 1.15) TO (-12.276, 8.8, 1.15) COLOR purple;\nPART DHRS_CABLE_CCBL_A_AV2 = WIRE(D=0.025) FROM (2.874, 2.05, 25.2) THROUGH (2.874, 8.015, 25.2), (2.874, 8.015, 18.25), (2.874, 22.58, 18.25), (-12.276, 22.58, 18.25), (-12.276, 22.58, 2.25) TO (-12.276, 8.8, 2.25) COLOR purple;\nPART DHRS_CABLE_CCBL_A_MDHRS = WIRE(D=0.025) FROM (-14.103, 1.2, 26.2) THROUGH (-14.103, 8.07, 26.2), (2.326, 8.07, 26.2), (2.326, 8.07, 25.3) TO (2.326, 2.05, 25.3) COLOR purple;\nPART DHRS_CABLE_CCBL_B_AV1 = WIRE(D=0.025) FROM (2.783, 2.05, 35.2) THROUGH (2.783, 8.125, 35.2), (2.783, 8.125, 18.35), (2.783, 22.7, 18.35), (-5.776, 22.7, 18.35), (-5.776, 22.7, 1.15) TO (-5.776, 8.8, 1.15) COLOR purple;\nPART DHRS_CABLE_CCBL_B_AV2 = WIRE(D=0.025) FROM (2.874, 2.05, 35.2) THROUGH (2.874, 8.18, 35.2), (2.874, 8.18, 18.4), (2.874, 22.76, 18.4), (-5.776, 22.76, 18.4), (-5.776, 22.76, 2.25) TO (-5.776, 8.8, 2.25) COLOR purple;\nPART DHRS_CABLE_CCBL_B_MDHRS = WIRE(D=0.025) FROM (-10.103, 1.2, 26.2) THROUGH (-10.103, 8.235, 26.2), (2.326, 8.235, 26.2), (2.326, 8.235, 35.3) TO (2.326, 2.05, 35.3) COLOR purple;\nALLOW DHRS_CABLE_* WITH RXB, RXB_GALLERY, RXB_CVCS, CB, CB_MCR, CB_ICA, CB_ICB, CB_DCA, CB_DCB, CB_HVACA, CB_HVACB, EB, EB_MV, EB_LVA, EB_LVB, EB_BESSA, EB_BESSB, AUX, AUX_CCW, TGB, TGB_FW, UHS_STRUCT_POOL;\nALLOW DHRS_CABLE_* WITH DHRS_CABLE_*;\n# cables of other systems share the same overhead raceways and risers\nALLOW DHRS_CABLE_* WITH OSP_CABLE_MVCBL_UAT, EPA_CABLE_MVCBL_A_XFMR, EPA_CABLE_PCBL_A_BESS, EPB_CABLE_MVCBL_B_XFMR, EPB_CABLE_PCBL_B_BESS, DCA_CABLE_DCBL_A_BAT, DCA_CABLE_PCBL_A_BCH, DCB_CABLE_DCBL_B_BAT, DCB_CABLE_PCBL_B_BCH, SEN_CABLE_CCBL_1, SEN_CABLE_CCBL_2, SEN_CABLE_CCBL_3;\nALLOW DHRS_CABLE_* WITH SEN_CABLE_CCBL_4, RPS_CABLE_CCBL_A_TRIP, RPS_CABLE_CCBL_A_MTRIP, RPS_CABLE_DCBL_A_SHT, RPS_CABLE_CCBL_B_TRIP, RPS_CABLE_CCBL_B_MTRIP, RPS_CABLE_DCBL_B_SHT, ESA_CABLE_DCBL_A_ESF, ESB_CABLE_DCBL_B_ESF, ECCS_CABLE_CCBL_RVV1A, ECCS_CABLE_CCBL_RVV1B, ECCS_CABLE_CCBL_RVV2A;\nALLOW DHRS_CABLE_* WITH ECCS_CABLE_CCBL_RVV2B, ECCS_CABLE_CCBL_RVV3A, ECCS_CABLE_CCBL_RVV3B, ECCS_CABLE_CCBL_RRV1A, ECCS_CABLE_CCBL_RRV1B, ECCS_CABLE_CCBL_RRV2A, ECCS_CABLE_CCBL_RRV2B, CIS_CABLE_PCBL_A_MSI, CIS_CABLE_CCBL_A_MSI, CIS_CABLE_PCBL_B_MSO, CIS_CABLE_CCBL_B_MSO, CIS_CABLE_PCBL_A_FWI;\nALLOW DHRS_CABLE_* WITH CIS_CABLE_CCBL_A_FWI, CIS_CABLE_PCBL_B_FWO, CIS_CABLE_CCBL_B_FWO, CIS_CABLE_PCBL_A_INJI, CIS_CABLE_CCBL_A_INJI, CIS_CABLE_PCBL_B_INJO, CIS_CABLE_CCBL_B_INJO, CIS_CABLE_PCBL_A_LTDI, CIS_CABLE_CCBL_A_LTDI, CIS_CABLE_PCBL_B_LTDO, CIS_CABLE_CCBL_B_LTDO, CVCS_CABLE_PCBL_A;\nALLOW DHRS_CABLE_* WITH CVCS_CABLE_PCBL_B, CVCS_CABLE_CCBL_B, CCW_CABLE_PCBL_A_PMP, CCW_CABLE_PCBL_B_PMP, CCW_CABLE_PCBL_A_FAN, CCW_CABLE_PCBL_B_FAN, CCW_CABLE_CCBL_B_PMP, CCW_CABLE_CCBL_B_FAN, CRV_CABLE_PCBL_A_AHU, CRV_CABLE_PCBL_B_AHU, CRV_CABLE_PCBL_A_CHL, CRV_CABLE_PCBL_B_CHL;\nALLOW DHRS_CABLE_* WITH CRV_CABLE_PCBL_A_DMP, CRV_CABLE_PCBL_B_DMP, CRV_CABLE_CCBL_B_START, FWS_CABLE_PCBL_COND, FWS_CABLE_MVCBL_A_FWP, FWS_CABLE_MVCBL_B_FWP, FWS_CABLE_CCBL_B_FWP;\nALLOW DHRS_PIPE_NPIPE_A_STM, DHRS_PIPE_NPIPE_A_CND, DHRS_PIPE_NPIPE_B_STM, DHRS_PIPE_NPIPE_B_CND WITH RXB, RXB_GALLERY, RXB_CVCS, CB, CB_MCR, CB_ICA, CB_ICB, CB_DCA, CB_DCB, CB_HVACA, CB_HVACB, EB, EB_MV, EB_LVA, EB_LVB, EB_BESSA, EB_BESSB, AUX, AUX_CCW, TGB, TGB_FW, UHS_STRUCT_POOL;\nALLOW DHRS_PIPE_NPIPE_A_STM, DHRS_PIPE_NPIPE_A_CND, DHRS_PIPE_NPIPE_B_STM, DHRS_PIPE_NPIPE_B_CND WITH CNV-SHELL, DHRS_HTX_HTX_A, DHRS_HTX_HTX_B, DHRS_VALVE_HOV_A_AV1, DHRS_VALVE_HOV_A_AV2, DHRS_VALVE_HOV_B_AV1, DHRS_VALVE_HOV_B_AV2;\nALLOW DHRS_PIPE_NPIPE_A_STM, DHRS_PIPE_NPIPE_A_CND, DHRS_PIPE_NPIPE_B_STM, DHRS_PIPE_NPIPE_B_CND WITH DHRS_PIPE_NPIPE_A_STM, DHRS_PIPE_NPIPE_A_CND, DHRS_PIPE_NPIPE_B_STM, DHRS_PIPE_NPIPE_B_CND;\n\n# --- leak rates (NRC-INL 2020: Normal Pipe external leakage 2.5E-10 /h-ft, gamma 0.5; Tank external leakage 1.2E-7 /h, gamma 0.5).\n#     MISSION is the 72-h mission (72-h file) or the restoration time (1-yr file: pipe 168 h, tank 336 h). ---\nLEAKRATE LR-DHRS-PIPE-SA ON DHRS_PIPE_NPIPE_A_STM RATE 2.5E-10 PER HOUR PER FT GAMMA 0.5 MISSION 72 HOURS FLUID WATER IGNITES NO;\nLEAKRATE LR-DHRS-PIPE-CA ON DHRS_PIPE_NPIPE_A_CND RATE 2.5E-10 PER HOUR PER FT GAMMA 0.5 MISSION 72 HOURS FLUID WATER IGNITES NO;\nLEAKRATE LR-DHRS-PIPE-SB ON DHRS_PIPE_NPIPE_B_STM RATE 2.5E-10 PER HOUR PER FT GAMMA 0.5 MISSION 72 HOURS FLUID WATER IGNITES NO;\nLEAKRATE LR-DHRS-PIPE-CB ON DHRS_PIPE_NPIPE_B_CND RATE 2.5E-10 PER HOUR PER FT GAMMA 0.5 MISSION 72 HOURS FLUID WATER IGNITES NO;\n"
      },
      "failureLogicTree": {
        "id": "top",
        "label": "Decay_Heat_Removal_System_Fails",
        "type": "OR",
        "children": [
          {
            "id": "train_a_and_train_b",
            "label": "TRAIN_A_AND_TRAIN_B",
            "type": "AND",
            "children": [
              {
                "id": "train-a",
                "label": "TRAIN-A",
                "type": "OR",
                "children": [
                  {
                    "id": "act-a",
                    "label": "ACT-A",
                    "type": "AND",
                    "children": [
                      {
                        "id": "esf-a",
                        "label": "ESF-A",
                        "type": "OR",
                        "children": [
                          {
                            "id": "esa",
                            "label": "ESA",
                            "type": "OR",
                            "children": [
                              {
                                "id": "esa-sensors",
                                "label": "ESA-SENSORS",
                                "type": "OR",
                                "children": [
                                  {
                                    "id": "esa-sen",
                                    "label": "ESA-SEN",
                                    "type": "3/4",
                                    "children": [
                                      {
                                        "id": "esa-sen-ch-1",
