      "view3d": {
        "script": "# 125 VDC Division B (DCB): 3D layout of its SSCs in the HSMR-77 buildings.\n# Parts are named with the SSC controlled names, so each part (or GROUP) links to its SSC.\n# Rooms and buildings come from the Project 3D script; cables are WIREs routed through the rooms.\n\nPART DCB_ELECT_BAT_B = BOX(W=2.6, H=1.2, L=1.0) IN CB_DCB AT (-1.5, 0, 1) COLOR yellow;\nPART DCB_ELECT_BCH_B = BOX(W=1.2, H=1.8, L=0.8) IN CB_DCB AT (2, 0, 2.2) COLOR 0x6f7a86;\nPART DCB_ELECT_BUS_B = BOX(W=2.4, H=2.2, L=0.8) IN CB_DCB AT (1.5, 0, -2.5) COLOR 0x4b6584;\nPART DCB_ELECT_CBK_B = BOX(W=1.0, H=1.6, L=0.4) IN CB_DCB AT (-1.8, 0, -2.8) COLOR 0x3f6f8f;\n\n# --- cables: power (red), DC (orange), MV (black) and control (purple), routed above the equipment ---\nPART DCB_CABLE_DCBL_B_BAT = WIRE(D=0.045) FROM (8.14, 1.25, 36) THROUGH (8.14, 6.64, 36), (11.14, 6.64, 36), (11.14, 6.64, 32.5) TO (11.14, 2.25, 32.5) COLOR orange;\nPART DCB_CABLE_PCBL_B_BCH = WIRE(D=0.05) FROM (57.64, 2.35, 0.5) THROUGH (57.64, 6.695, 0.5), (11.64, 6.695, 0.5), (11.64, 6.695, 37.2) TO (11.64, 1.85, 37.2) COLOR red;\nALLOW DCB_CABLE_* WITH RXB, RXB_GALLERY, RXB_CVCS, CB, CB_MCR, CB_ICA, CB_ICB, CB_DCA, CB_DCB, CB_HVACA, CB_HVACB, EB, EB_MV, EB_LVA, EB_LVB, EB_BESSA, EB_BESSB, AUX, AUX_CCW, TGB, TGB_FW, UHS_STRUCT_POOL;\nALLOW DCB_CABLE_* WITH DCB_CABLE_*;\n# cables of other systems share the same overhead raceways and risers\nALLOW DCB_CABLE_* WITH OSP_CABLE_MVCBL_UAT, EPA_CABLE_MVCBL_A_XFMR, EPA_CABLE_PCBL_A_BESS, EPB_CABLE_MVCBL_B_XFMR, EPB_CABLE_PCBL_B_BESS, DCA_CABLE_DCBL_A_BAT, DCA_CABLE_PCBL_A_BCH, SEN_CABLE_CCBL_1, SEN_CABLE_CCBL_2, SEN_CABLE_CCBL_3, SEN_CABLE_CCBL_4, RPS_CABLE_CCBL_A_TRIP;\nALLOW DCB_CABLE_* WITH RPS_CABLE_CCBL_A_MTRIP, RPS_CABLE_DCBL_A_SHT, RPS_CABLE_CCBL_B_TRIP, RPS_CABLE_CCBL_B_MTRIP, RPS_CABLE_DCBL_B_SHT, ESA_CABLE_DCBL_A_ESF, ESB_CABLE_DCBL_B_ESF, ECCS_CABLE_CCBL_RVV1A, ECCS_CABLE_CCBL_RVV1B, ECCS_CABLE_CCBL_RVV2A, ECCS_CABLE_CCBL_RVV2B, ECCS_CABLE_CCBL_RVV3A;\nALLOW DCB_CABLE_* WITH ECCS_CABLE_CCBL_RVV3B, ECCS_CABLE_CCBL_RRV1A, ECCS_CABLE_CCBL_RRV1B, ECCS_CABLE_CCBL_RRV2A, ECCS_CABLE_CCBL_RRV2B, DHRS_CABLE_CCBL_A_AV1, DHRS_CABLE_CCBL_A_AV2, DHRS_CABLE_CCBL_A_MDHRS, DHRS_CABLE_CCBL_B_AV1, DHRS_CABLE_CCBL_B_AV2, DHRS_CABLE_CCBL_B_MDHRS, CIS_CABLE_PCBL_A_MSI;\nALLOW DCB_CABLE_* WITH CIS_CABLE_CCBL_A_MSI, CIS_CABLE_PCBL_B_MSO, CIS_CABLE_CCBL_B_MSO, CIS_CABLE_PCBL_A_FWI, CIS_CABLE_CCBL_A_FWI, CIS_CABLE_PCBL_B_FWO, CIS_CABLE_CCBL_B_FWO, CIS_CABLE_PCBL_A_INJI, CIS_CABLE_CCBL_A_INJI, CIS_CABLE_PCBL_B_INJO, CIS_CABLE_CCBL_B_INJO, CIS_CABLE_PCBL_A_LTDI;\nALLOW DCB_CABLE_* WITH CIS_CABLE_CCBL_A_LTDI, CIS_CABLE_PCBL_B_LTDO, CIS_CABLE_CCBL_B_LTDO, CVCS_CABLE_PCBL_A, CVCS_CABLE_PCBL_B, CVCS_CABLE_CCBL_B, CCW_CABLE_PCBL_A_PMP, CCW_CABLE_PCBL_B_PMP, CCW_CABLE_PCBL_A_FAN, CCW_CABLE_PCBL_B_FAN, CCW_CABLE_CCBL_B_PMP, CCW_CABLE_CCBL_B_FAN;\nALLOW DCB_CABLE_* WITH CRV_CABLE_PCBL_A_AHU, CRV_CABLE_PCBL_B_AHU, CRV_CABLE_PCBL_A_CHL, CRV_CABLE_PCBL_B_CHL, CRV_CABLE_PCBL_A_DMP, CRV_CABLE_PCBL_B_DMP, CRV_CABLE_CCBL_B_START, FWS_CABLE_PCBL_COND, FWS_CABLE_MVCBL_A_FWP, FWS_CABLE_MVCBL_B_FWP, FWS_CABLE_CCBL_B_FWP;\n"
      },
