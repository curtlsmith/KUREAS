      "view3d": {
        "script": "# Containment Isolation System (CIS): 3D layout of its SSCs in the HSMR-77 buildings.\n# Parts are named with the SSC controlled names, so each part (or GROUP) links to its SSC.\n# Rooms and buildings come from the Project 3D script; cables are WIREs routed through the rooms.\n\nPART CIS_VALVE_MOV_A_MSI = VALVE(D=0.25) IN RXB_GALLERY AT (-3.4, 1, -4.6) COLOR 0x3f6f8f;\nPART CIS_VALVE_MOV_B_MSO = VALVE(D=0.25) IN RXB_GALLERY AT (1.2, 1, -4.6) COLOR 0x2f6fb5;\nPART CIS_VALVE_MOV_A_FWI = VALVE(D=0.25) IN RXB_GALLERY AT (-3.4, 1, -2.6) COLOR 0x3f6f8f;\nPART CIS_VALVE_MOV_B_FWO = VALVE(D=0.25) IN RXB_GALLERY AT (1.2, 1, -2.6) COLOR 0x2f6fb5;\nPART CIS_VALVE_MOV_A_INJI = VALVE(D=0.25) IN RXB_GALLERY AT (-3.4, 1, -0.6) COLOR 0x3f6f8f;\nPART CIS_VALVE_MOV_B_INJO = VALVE(D=0.25) IN RXB_GALLERY AT (1.2, 1, -0.6) COLOR 0x2f6fb5;\nPART CIS_VALVE_MOV_A_LTDI = VALVE(D=0.25) IN RXB_GALLERY AT (-3.4, 1, 1.4) COLOR 0x3f6f8f;\nPART CIS_VALVE_MOV_B_LTDO = VALVE(D=0.25) IN RXB_GALLERY AT (1.2, 1, 1.4) COLOR 0x2f6fb5;\n\n# --- cables: power (red), DC (orange), MV (black) and control (purple), routed above the equipment ---\nPART CIS_CABLE_PCBL_A_MSI = WIRE(D=0.05) FROM (43.76, 2.35, 0.5) THROUGH (43.76, 8.29, 0.5), (10.432, 8.29, 0.5), (10.432, 8.29, -12.6) TO (10.432, 1.85, -12.6) COLOR red;\nPART CIS_CABLE_CCBL_A_MSI = WIRE(D=0.025) FROM (2.417, 2.05, 25.3) THROUGH (2.417, 8.345, 25.3), (10.446, 8.345, 25.3), (10.446, 8.345, -12.6) TO (10.446, 1.85, -12.6) COLOR purple;\nPART CIS_CABLE_PCBL_B_MSO = WIRE(D=0.05) FROM (57.76, 2.35, 0.5) THROUGH (57.76, 6.2, 0.5), (15.032, 6.2, 0.5), (15.032, 6.2, -12.6) TO (15.032, 1.85, -12.6) COLOR red;\nPART CIS_CABLE_CCBL_B_MSO = WIRE(D=0.025) FROM (2.417, 2.05, 35.3) THROUGH (2.417, 6.255, 35.3), (15.046, 6.255, 35.3), (15.046, 6.255, -12.6) TO (15.046, 1.85, -12.6) COLOR purple;\nPART CIS_CABLE_PCBL_A_FWI = WIRE(D=0.05) FROM (43.88, 2.35, 0.5) THROUGH (43.88, 6.31, 0.5), (10.432, 6.31, 0.5), (10.432, 6.31, -10.6) TO (10.432, 1.85, -10.6) COLOR red;\nPART CIS_CABLE_CCBL_A_FWI = WIRE(D=0.025) FROM (2.509, 2.05, 25.3) THROUGH (2.509, 6.365, 25.3), (10.446, 6.365, 25.3), (10.446, 6.365, -10.6) TO (10.446, 1.85, -10.6) COLOR purple;\nPART CIS_CABLE_PCBL_B_FWO = WIRE(D=0.05) FROM (57.88, 2.35, 0.5) THROUGH (57.88, 6.42, 0.5), (15.032, 6.42, 0.5), (15.032, 6.42, -10.6) TO (15.032, 1.85, -10.6) COLOR red;\nPART CIS_CABLE_CCBL_B_FWO = WIRE(D=0.025) FROM (2.509, 2.05, 35.3) THROUGH (2.509, 6.475, 35.3), (15.046, 6.475, 35.3), (15.046, 6.475, -10.6) TO (15.046, 1.85, -10.6) COLOR purple;\nPART CIS_CABLE_PCBL_A_INJI = WIRE(D=0.05) FROM (44, 2.35, 0.5) THROUGH (44, 6.53, 0.5), (10.432, 6.53, 0.5), (10.432, 6.53, -8.6) TO (10.432, 1.85, -8.6) COLOR red;\nPART CIS_CABLE_CCBL_A_INJI = WIRE(D=0.025) FROM (2.6, 2.05, 25.3) THROUGH (2.6, 6.585, 25.3), (10.446, 6.585, 25.3), (10.446, 6.585, -8.6) TO (10.446, 1.85, -8.6) COLOR purple;\nPART CIS_CABLE_PCBL_B_INJO = WIRE(D=0.05) FROM (58, 2.35, 0.5) THROUGH (58, 6.64, 0.5), (15.032, 6.64, 0.5), (15.032, 6.64, -8.6) TO (15.032, 1.85, -8.6) COLOR red;\nPART CIS_CABLE_CCBL_B_INJO = WIRE(D=0.025) FROM (2.6, 2.05, 35.3) THROUGH (2.6, 6.695, 35.3), (15.046, 6.695, 35.3), (15.046, 6.695, -8.6) TO (15.046, 1.85, -8.6) COLOR purple;\nPART CIS_CABLE_PCBL_A_LTDI = WIRE(D=0.05) FROM (44.12, 2.35, 0.5) THROUGH (44.12, 6.75, 0.5), (10.432, 6.75, 0.5), (10.432, 6.75, -6.6) TO (10.432, 1.85, -6.6) COLOR red;\nPART CIS_CABLE_CCBL_A_LTDI = WIRE(D=0.025) FROM (2.691, 2.05, 25.3) THROUGH (2.691, 6.805, 25.3), (10.446, 6.805, 25.3), (10.446, 6.805, -6.6) TO (10.446, 1.85, -6.6) COLOR purple;\nPART CIS_CABLE_PCBL_B_LTDO = WIRE(D=0.05) FROM (58.12, 2.35, 0.5) THROUGH (58.12, 6.86, 0.5), (15.032, 6.86, 0.5), (15.032, 6.86, -6.6) TO (15.032, 1.85, -6.6) COLOR red;\nPART CIS_CABLE_CCBL_B_LTDO = WIRE(D=0.025) FROM (2.691, 2.05, 35.3) THROUGH (2.691, 6.915, 35.3), (15.046, 6.915, 35.3), (15.046, 6.915, -6.6) TO (15.046, 1.85, -6.6) COLOR purple;\nALLOW CIS_CABLE_* WITH RXB, RXB_GALLERY, RXB_CVCS, CB, CB_MCR, CB_ICA, CB_ICB, CB_DCA, CB_DCB, CB_HVACA, CB_HVACB, EB, EB_MV, EB_LVA, EB_LVB, EB_BESSA, EB_BESSB, AUX, AUX_CCW, TGB, TGB_FW, UHS_STRUCT_POOL;\nALLOW CIS_CABLE_* WITH CIS_CABLE_*;\n# cables of other systems share the same overhead raceways and risers\nALLOW CIS_CABLE_* WITH OSP_CABLE_MVCBL_UAT, EPA_CABLE_MVCBL_A_XFMR, EPA_CABLE_PCBL_A_BESS, EPB_CABLE_MVCBL_B_XFMR, EPB_CABLE_PCBL_B_BESS, DCA_CABLE_DCBL_A_BAT, DCA_CABLE_PCBL_A_BCH, DCB_CABLE_DCBL_B_BAT, DCB_CABLE_PCBL_B_BCH, SEN_CABLE_CCBL_1, SEN_CABLE_CCBL_2, SEN_CABLE_CCBL_3;\nALLOW CIS_CABLE_* WITH SEN_CABLE_CCBL_4, RPS_CABLE_CCBL_A_TRIP, RPS_CABLE_CCBL_A_MTRIP, RPS_CABLE_DCBL_A_SHT, RPS_CABLE_CCBL_B_TRIP, RPS_CABLE_CCBL_B_MTRIP, RPS_CABLE_DCBL_B_SHT, ESA_CABLE_DCBL_A_ESF, ESB_CABLE_DCBL_B_ESF, ECCS_CABLE_CCBL_RVV1A, ECCS_CABLE_CCBL_RVV1B, ECCS_CABLE_CCBL_RVV2A;\nALLOW CIS_CABLE_* WITH ECCS_CABLE_CCBL_RVV2B, ECCS_CABLE_CCBL_RVV3A, ECCS_CABLE_CCBL_RVV3B, ECCS_CABLE_CCBL_RRV1A, ECCS_CABLE_CCBL_RRV1B, ECCS_CABLE_CCBL_RRV2A, ECCS_CABLE_CCBL_RRV2B, DHRS_CABLE_CCBL_A_AV1, DHRS_CABLE_CCBL_A_AV2, DHRS_CABLE_CCBL_A_MDHRS, DHRS_CABLE_CCBL_B_AV1, DHRS_CABLE_CCBL_B_AV2;\nALLOW CIS_CABLE_* WITH DHRS_CABLE_CCBL_B_MDHRS, CVCS_CABLE_PCBL_A, CVCS_CABLE_PCBL_B, CVCS_CABLE_CCBL_B, CCW_CABLE_PCBL_A_PMP, CCW_CABLE_PCBL_B_PMP, CCW_CABLE_PCBL_A_FAN, CCW_CABLE_PCBL_B_FAN, CCW_CABLE_CCBL_B_PMP, CCW_CABLE_CCBL_B_FAN, CRV_CABLE_PCBL_A_AHU, CRV_CABLE_PCBL_B_AHU;\nALLOW CIS_CABLE_* WITH CRV_CABLE_PCBL_A_CHL, CRV_CABLE_PCBL_B_CHL, CRV_CABLE_PCBL_A_DMP, CRV_CABLE_PCBL_B_DMP, CRV_CABLE_CCBL_B_START, FWS_CABLE_PCBL_COND, FWS_CABLE_MVCBL_A_FWP, FWS_CABLE_MVCBL_B_FWP, FWS_CABLE_CCBL_B_FWP;\n"
      },
