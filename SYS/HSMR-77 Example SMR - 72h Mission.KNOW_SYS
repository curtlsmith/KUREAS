      "view3d": {
        "script": "# Offsite Power and 13.8 kV Distribution (OSP): 3D layout of its SSCs in the HSMR-77 buildings.\n# Parts are named with the SSC controlled names, so each part (or GROUP) links to its SSC.\n# Rooms and buildings come from the Project 3D script; cables are WIREs routed through the rooms.\n\nPART OSP_ELECT_CBK_SY = BOX(W=1.6, H=3.0, L=1.4) AT (30, 0.2, -43) COLOR 0x4b6584;\nPART OSP_ELECT_CBK_INC = BOX(W=1.0, H=2.4, L=1.6) IN EB_MV AT (-10, 0, 0) COLOR 0x4b6584;\nPART OSP_ELECT_BUS_SWGR13 = BOX(W=12, H=2.4, L=1.6) IN EB_MV AT (0, 0, 0) COLOR 0x4b6584;\n# --- the 69 kV line on wood poles from the grid (off the drawing, west) to the switchyard ---\nPART GRID-POLE-1 = CYLINDER(D=0.34, H=12.2) AT (-34, 0, -44) COLOR 0x6b4f35 NOLABEL;\nPART GRID-ARM-1 = BOX(W=0.16, H=0.16, L=2.6) AT (-34, 12.0, -44) COLOR 0x6b4f35 NOLABEL;\nPART GRID-POLE-2 = CYLINDER(D=0.34, H=12.2) AT (-18, 0, -44) COLOR 0x6b4f35 NOLABEL;\nPART GRID-ARM-2 = BOX(W=0.16, H=0.16, L=2.6) AT (-18, 12.0, -44) COLOR 0x6b4f35 NOLABEL;\nPART GRID-POLE-3 = CYLINDER(D=0.34, H=12.2) AT (-2, 0, -44) COLOR 0x6b4f35 NOLABEL;\nPART GRID-ARM-3 = BOX(W=0.16, H=0.16, L=2.6) AT (-2, 12.0, -44) COLOR 0x6b4f35 NOLABEL;\nPART GRID-POLE-4 = CYLINDER(D=0.34, H=12.2) AT (14, 0, -44) COLOR 0x6b4f35 NOLABEL;\nPART GRID-ARM-4 = BOX(W=0.16, H=0.16, L=2.6) AT (14, 12.0, -44) COLOR 0x6b4f35 NOLABEL;\nPART GRID-PH-A = WIRE(D=0.03) FROM (-46, 12.25, -45.0) THROUGH (-34, 12.25, -45), (-26, 11.6, -45), (-18, 12.25, -45), (-10, 11.6, -45), (-2, 12.25, -45), (6, 11.6, -45), (14, 12.25, -45) TO (29, 3.1, -44.3) COLOR black NOLABEL;\nPART GRID-PH-B = WIRE(D=0.03) FROM (-46, 12.25, -44.0) THROUGH (-34, 12.25, -44), (-26, 11.6, -44), (-18, 12.25, -44), (-10, 11.6, -44), (-2, 12.25, -44), (6, 11.6, -44), (14, 12.25, -44) TO (29, 3.1, -44) COLOR black NOLABEL;\nPART GRID-PH-C = WIRE(D=0.03) FROM (-46, 12.25, -43.0) THROUGH (-34, 12.25, -43), (-26, 11.6, -43), (-18, 12.25, -43), (-10, 11.6, -43), (-2, 12.25, -43), (6, 11.6, -43), (14, 12.25, -43) TO (29, 3.1, -43.7) COLOR black NOLABEL;\nGROUP OSP_ELECT_OSP = GRID-POLE-1, GRID-ARM-1, GRID-POLE-2, GRID-ARM-2, GRID-POLE-3, GRID-ARM-3, GRID-POLE-4, GRID-ARM-4, GRID-PH-A, GRID-PH-B, GRID-PH-C;\nJOIN OSP_ELECT_OSP;\nALLOW GRID-PH-A, GRID-PH-B, GRID-PH-C WITH OSP_ELECT_CBK_SY;\nTEXT \"Offsite 69 kV line\" AT (-10, 13.5, -44) SIZE 1.2;\n# --- the unit auxiliary transformer on its pad in the switchyard ---\nPART OSP_ELECT_TRANS_UAT = BOX(W=3.2, H=3.2, L=2.4) AT (42, 0.2, -34) COLOR 0x5d7a5a;\nARRAY UAT-FIN = BOX(W=0.5, H=2.4, L=0.06) AT (43.85, 0.6, -35.05) LINE(N=8, PITCH=0.3, AXIS=Z) COLOR 0x5d7a5a NOLABEL;\nARRAY UAT-BUSHING = CYLINDER(D=0.18, H=0.7) AT (41.3, 3.4, -34) LINE(N=3, PITCH=0.7, AXIS=X) COLOR brown NOLABEL;\nALLOW UAT-FIN, UAT-BUSHING WITH OSP_ELECT_TRANS_UAT;\nALLOW UAT-FIN WITH UAT-FIN;\nALLOW OSP_ELECT_TRANS_UAT, UAT-FIN, UAT-BUSHING WITH X-YARD;\n\n# --- cables: power (red), DC (orange), MV (black) and control (purple), routed above the equipment ---\nPART OSP_CABLE_MVCBL_UAT = WIRE(D=0.08) FROM (41.64, 3.5, -33.2) THROUGH (41.64, 6.255, -33.2), (39.657, 6.255, -33.2), (39.657, 6.255, -12.5) TO (39.657, 2.45, -12.5) COLOR black;\nALLOW OSP_CABLE_* WITH RXB, RXB_GALLERY, RXB_CVCS, CB, CB_MCR, CB_ICA, CB_ICB, CB_DCA, CB_DCB, CB_HVACA, CB_HVACB, EB, EB_MV, EB_LVA, EB_LVB, EB_BESSA, EB_BESSB, AUX, AUX_CCW, TGB, TGB_FW, UHS_STRUCT_POOL;\nALLOW OSP_CABLE_* WITH OSP_CABLE_*;\n# cables of other systems share the same overhead raceways and risers\nALLOW OSP_CABLE_* WITH EPA_CABLE_MVCBL_A_XFMR, EPA_CABLE_PCBL_A_BESS, EPB_CABLE_MVCBL_B_XFMR, EPB_CABLE_PCBL_B_BESS, DCA_CABLE_DCBL_A_BAT, DCA_CABLE_PCBL_A_BCH, DCB_CABLE_DCBL_B_BAT, DCB_CABLE_PCBL_B_BCH, SEN_CABLE_CCBL_1, SEN_CABLE_CCBL_2, SEN_CABLE_CCBL_3, SEN_CABLE_CCBL_4;\nALLOW OSP_CABLE_* WITH RPS_CABLE_CCBL_A_TRIP, RPS_CABLE_CCBL_A_MTRIP, RPS_CABLE_DCBL_A_SHT, RPS_CABLE_CCBL_B_TRIP, RPS_CABLE_CCBL_B_MTRIP, RPS_CABLE_DCBL_B_SHT, ESA_CABLE_DCBL_A_ESF, ESB_CABLE_DCBL_B_ESF, ECCS_CABLE_CCBL_RVV1A, ECCS_CABLE_CCBL_RVV1B, ECCS_CABLE_CCBL_RVV2A, ECCS_CABLE_CCBL_RVV2B;\nALLOW OSP_CABLE_* WITH ECCS_CABLE_CCBL_RVV3A, ECCS_CABLE_CCBL_RVV3B, ECCS_CABLE_CCBL_RRV1A, ECCS_CABLE_CCBL_RRV1B, ECCS_CABLE_CCBL_RRV2A, ECCS_CABLE_CCBL_RRV2B, DHRS_CABLE_CCBL_A_AV1, DHRS_CABLE_CCBL_A_AV2, DHRS_CABLE_CCBL_A_MDHRS, DHRS_CABLE_CCBL_B_AV1, DHRS_CABLE_CCBL_B_AV2, DHRS_CABLE_CCBL_B_MDHRS;\nALLOW OSP_CABLE_* WITH CIS_CABLE_PCBL_A_MSI, CIS_CABLE_CCBL_A_MSI, CIS_CABLE_PCBL_B_MSO, CIS_CABLE_CCBL_B_MSO, CIS_CABLE_PCBL_A_FWI, CIS_CABLE_CCBL_A_FWI, CIS_CABLE_PCBL_B_FWO, CIS_CABLE_CCBL_B_FWO, CIS_CABLE_PCBL_A_INJI, CIS_CABLE_CCBL_A_INJI, CIS_CABLE_PCBL_B_INJO, CIS_CABLE_CCBL_B_INJO;\nALLOW OSP_CABLE_* WITH CIS_CABLE_PCBL_A_LTDI, CIS_CABLE_CCBL_A_LTDI, CIS_CABLE_PCBL_B_LTDO, CIS_CABLE_CCBL_B_LTDO, CVCS_CABLE_PCBL_A, CVCS_CABLE_PCBL_B, CVCS_CABLE_CCBL_B, CCW_CABLE_PCBL_A_PMP, CCW_CABLE_PCBL_B_PMP, CCW_CABLE_PCBL_A_FAN, CCW_CABLE_PCBL_B_FAN, CCW_CABLE_CCBL_B_PMP;\nALLOW OSP_CABLE_* WITH CCW_CABLE_CCBL_B_FAN, CRV_CABLE_PCBL_A_AHU, CRV_CABLE_PCBL_B_AHU, CRV_CABLE_PCBL_A_CHL, CRV_CABLE_PCBL_B_CHL, CRV_CABLE_PCBL_A_DMP, CRV_CABLE_PCBL_B_DMP, CRV_CABLE_CCBL_B_START, FWS_CABLE_PCBL_COND, FWS_CABLE_MVCBL_A_FWP, FWS_CABLE_MVCBL_B_FWP, FWS_CABLE_CCBL_B_FWP;\n"
      },
